<script>

    document.addEventListener('DOMContentLoaded', function() {
        const buttons = document.querySelectorAll('.tab-button');
        const viewAllBtns = document.querySelectorAll('.view-all-btn');
        const contents = document.querySelectorAll('.tab-content');
        const closeBtn = document.querySelector('.close-btn');

        buttons.forEach(button => {
            button.addEventListener('click', function(e) {
                const tabName = this.getAttribute('data-tab');

                buttons.forEach(btn => btn.classList.remove('active'));

                contents.forEach(content => {
                    content.classList.remove('active');
                    content.style.display = '';
                });

                this.classList.add('active');

                const activeTab = document.getElementById(tabName);
                activeTab.classList.add('active');
                activeTab.style.display = 'block';
            });
        });

        viewAllBtns.forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                const tabName = this.getAttribute('data-tab');
                const table = document.querySelector(`#${tabName} .schedule-table tbody`);
                const hiddenRows = table.querySelectorAll('tr.hidden');
                const count = this.getAttribute('data-count');

                hiddenRows.forEach(row => {
                    row.classList.toggle('show-all');
                });

                if (this.textContent.includes('Vedi tutti')) {
                    this.textContent = 'Mostra meno';
                } else {
                    this.textContent = `Vedi tutti (${count})`;
                }
            });
        });

        const button = document.querySelector('.close-section-btn');
        if(!button) {
            const wrappers = document.querySelectorAll('.view-all-wrapper');
            wrappers.forEach(wrapper => {
                if (!wrapper.querySelector('.close-section-btn')) {
                    wrapper.insertAdjacentHTML('beforeend',
                        '<button class="close-section-btn" data-tab="' + wrapper.querySelector('.view-all-btn').dataset.tab + '"> ✕ </button>');
                }
            });
        }

        const closeSectionBtns = document.querySelectorAll('.close-section-btn');
        closeSectionBtns.forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                const tabName = this.getAttribute('data-tab');
                const content = document.getElementById(tabName);
                if (content) {
                    content.style.display = 'none';
                }
            });
        });

    });
</script>


