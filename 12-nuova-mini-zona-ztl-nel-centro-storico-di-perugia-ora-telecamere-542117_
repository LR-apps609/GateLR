    .uj-flash-audio-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        margin: 14px 0 18px;
    }

    #uj-flash-audio-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: #00a8ff;
        color: #fff;
        border: 0;
        border-radius: 6px;
        padding: 8px 13px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        line-height: 1.2;
        box-shadow: 0 0 10px rgba(0,168,255,.45);
        transition: .2s ease;
    }

    #uj-flash-audio-btn:hover {
        background: #008ee6;
        transform: translateY(-1px);
        box-shadow: 0 0 14px rgba(0,168,255,.60);
    }

    #uj-flash-audio-btn.is-playing {
        background: #333;
        box-shadow: none;
    }

    #uj-flash-voice {
        border: 1px solid #00a8ff;
        border-radius: 6px;
        padding: 7px 9px;
        font-size: 13px;
        background: #fff;
        max-width: 230px;
    }
    </style>

    <script>
    (function () {
        function initFlashAudio() {
            const article =
                document.querySelector('.entry-content') ||
                document.querySelector('article');

            if (!article || !('speechSynthesis' in window)) return;
            if (document.getElementById('uj-flash-audio-btn')) return;

            const synth = window.speechSynthesis;
            const flashPattern = /FLASH\s+NEWS\s*[–—-]/i;

            let flashElement = null;
            let flashText = '';

            // Individua il paragrafo del flash.
            for (const el of article.querySelectorAll('p')) {
                const txt = (el.innerText || '').trim();

                if (flashPattern.test(txt)) {
                    flashElement = el;
                    flashText = txt;
                    break;
                }
            }

            // Gestisce anche flash senza un paragrafo.
            if (!flashElement) {
                const candidates = Array.from(
                    article.querySelectorAll('strong, b, div')
                ).filter(function (el) {
                    return flashPattern.test(el.innerText || '');
                });

                flashElement = candidates.find(function (el) {
                    return !candidates.some(function (other) {
                        return other !== el && el.contains(other);
                    });
                }) || null;

                if (flashElement) {
                    flashText = (flashElement.innerText || '').trim();
                }
            }

            if (!flashElement || !flashText) return;

            flashText = flashText
                .replace(/📌/g, '')
                .replace(flashPattern, '')
                .trim();

            if (!flashText) return;

            const wrap = document.createElement('div');
            wrap.className = 'uj-flash-audio-wrap';

            const btn = document.createElement('button');
            btn.id = 'uj-flash-audio-btn';
            btn.type = 'button';
            btn.innerHTML =
                '<span>🔊</span><span>Ascolta Flash</span>';

            const select = document.createElement('select');
            select.id = 'uj-flash-voice';
            select.setAttribute('aria-label', 'Voce di lettura');

            wrap.appendChild(btn);
            wrap.appendChild(select);

            // Inserisce il pulsante subito sotto il flash.
            flashElement.insertAdjacentElement('afterend', wrap);

            let voices = [];
            let speaking = false;
            let currentUtterance = null;

            function resetButton() {
                speaking = false;
                currentUtterance = null;
                btn.classList.remove('is-playing');
                btn.innerHTML =
                    '<span>🔊</span><span>Ascolta Flash</span>';
            }

            function loadVoices() {
                voices = synth.getVoices();

                const italianVoices = voices.filter(function (voice) {
                    return voice.lang &&
                        voice.lang.toLowerCase().startsWith('it');
                });

                const previousValue = select.value;
                select.innerHTML = '';

                if (!italianVoices.length) {
                    const option = document.createElement('option');
                    option.value = '';
                    option.textContent = 'Italiano di sistema';
                    select.appendChild(option);
                    return;
                }

                italianVoices.forEach(function (voice) {
                    const option = document.createElement('option');
                    option.value = voice.name;
                    option.textContent = voice.name;
                    select.appendChild(option);
                });

                let savedVoice = '';

                try {
                    savedVoice =
                        localStorage.getItem('ujFlashVoice') || '';
                } catch (error) {
                    // La lettura funziona anche senza localStorage.
                }

                const existingVoice = italianVoices.find(function (voice) {
                    return voice.name === (previousValue || savedVoice);
                });

                const preferred =
                    existingVoice ||
                    italianVoices.find(function (voice) {
                        return /google/i.test(voice.name);
                    }) ||
                    italianVoices[0];

                select.value = preferred.name;
            }

            loadVoices();
            synth.addEventListener('voiceschanged', loadVoices);

            select.addEventListener('change', function () {
                try {
                    localStorage.setItem('ujFlashVoice', select.value);
                } catch (error) {
                    // Nessun blocco se il salvataggio non è disponibile.
                }
            });

            btn.addEventListener('click', function () {
                if (speaking) {
                    synth.cancel();
                    resetButton();
                    return;
                }

                synth.cancel();

                const utterance =
                    new SpeechSynthesisUtterance(flashText);

                currentUtterance = utterance;
                utterance.lang = 'it-IT';
                utterance.rate = 0.90;
                utterance.pitch = 0.96;
                utterance.volume = 1;

                const selectedVoice = voices.find(function (voice) {
                    return voice.name === select.value;
                });

                if (selectedVoice) {
                    utterance.voice = selectedVoice;
                }

                speaking = true;
                btn.classList.add('is-playing');
                btn.innerHTML =
                    '<span>⏹</span><span>Ferma Flash</span>';

                utterance.onend = function () {
                    if (currentUtterance === utterance) {
                        resetButton();
                    }
                };

                utterance.onerror = function () {
                    if (currentUtterance === utterance) {
                        resetButton();
                    }
                };

                synth.speak(utterance);
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener(
                'DOMContentLoaded',
                initFlashAudio
            );
        } else {
            initFlashAudio();
        }
    })();
    </script>
    
