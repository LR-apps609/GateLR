<style>
#ri-audio{
    box-sizing:border-box;clear:both;
    margin:18px 0;padding:14px;
    border:1px solid #ddd;border-left:4px solid #b51f24;
    background:#fafafa;color:#222;
    font:16px/1.5 Arial,sans-serif;text-align:left;
}
#ri-audio .ri-controls,#ri-audio .ri-settings{
    display:flex;flex-wrap:wrap;gap:8px;align-items:center;
}
#ri-audio .ri-settings{margin-top:12px}
#ri-audio button,#ri-audio select{
    box-sizing:border-box;min-height:44px;max-width:100%;
    padding:9px 12px;border:1px solid #aaa;border-radius:5px;
    background:#fff;color:#222;font:inherit;
}
#ri-audio button{cursor:pointer}
#ri-audio .ri-play{
    background:#b51f24;border-color:#b51f24;
    color:#fff;font-weight:bold;
}
#ri-audio button:disabled{opacity:.5;cursor:default}
#ri-audio button:focus-visible,#ri-audio select:focus-visible{
    outline:3px solid #005fcc;outline-offset:3px;
}
#ri-audio .ri-status{
    display:block;margin-top:8px;font-size:13px;
}
@media print{#ri-audio{display:none}}
</style>
<script>
(function(){
'use strict';

function init(){
    if(document.getElementById('ri-audio')) return;
    if(!('speechSynthesis' in window) ||
       !('SpeechSynthesisUtterance' in window)) return;

    const article=document.querySelector('article[id^="post-"]');
    const body=article && article.querySelector('.entry-content');
    const title=article && article.querySelector('h1.entry-title');
    if(!body || !title) return;

    const excluded=[
        'script','style','noscript','iframe','figure','figcaption',
        'form','button','nav','aside','ins','[hidden]',
        '[aria-hidden="true"]','.addtoany_share_save_container',
        '.gtranslate_wrapper','.adrotate_widgets','.a-single',
        '.adsbygoogle','.sharedaddy','.jp-relatedposts',
        '.mh-related-content','.wp-caption','.ri-no-audio',
        '[data-no-audio]','#ri-audio',
        '.uj-flash-audio-wrap','#uj-flash-audio-btn'
    ].join(',');

    function normal(text){
        return String(text || '')
            .replace(/[\u200B-\u200D\u2060\uFEFF\uFE0E\uFE0F]/g,'')
            .replace(/&(?:ast|midast);|&#0*42;|&#x0*2a;/gi,'')
            .replace(/[*＊﹡∗`]/g,'')
            .replace(/^\s*#{1,6}\s+/gm,'')
            .replace(/\s+/g,' ')
            .trim();
    }

    function skipText(text){
        const start=text
            .replace(/^[^A-Za-zÀ-ÖØ-öø-ÿ0-9]+/,'')
            .trim();

        return /^(?:tweet\s*[:–—-]?\s*)?flash\s*news\b/i.test(start)
            || /^(?:meta\s*description|parole\s*chiave|hashtags?)\s*[:–—-]/i.test(start)
            || /^tweet\s*[:–—-]/i.test(start)
            || /^[\s_\-–—=•·]+$/.test(text);
    }

    const clean=body.cloneNode(true);
    clean.querySelectorAll(excluded).forEach(el=>el.remove());
    clean.querySelectorAll('br').forEach(el=>{
        el.replaceWith(document.createTextNode('\n'));
    });

    const heading=normal(title.textContent);
    const blocks=[];

    Array.from(clean.querySelectorAll('h2,h3,h4,p,li'))
        .filter(el=>!el.querySelector('h2,h3,h4,p,li'))
        .forEach(el=>{
            const raw=el.textContent || '';
            const whole=normal(raw);
            if(!whole || whole===heading || skipText(whole)) return;

            const lines=raw.split(/[\r\n]+/)
                .map(normal)
                .filter(text=>text && !skipText(text));

            const text=normal(lines.join(' '));
            if(text && text!==heading) blocks.push(text);
        });

    if(!blocks.length) return;

    // Passaggi brevi per la lettura degli articoli lunghi.
    const chunks=[];
    [heading,...blocks].forEach(text=>{
        const sentences=text.match(/[^.!?]+(?:[.!?]+|$)/g) || [text];
        sentences.forEach(sentence=>{
            let part=sentence.trim();
            while(part.length>180){
                const fragment=part.slice(0,181);
                let cut=Math.max(
                    fragment.lastIndexOf(';'),
                    fragment.lastIndexOf(':'),
                    fragment.lastIndexOf(',')
                );
                if(cut>=60) cut++;
                else cut=fragment.lastIndexOf(' ');
                if(cut<1) cut=180;

                chunks.push(part.slice(0,cut).trim());
                part=part.slice(cut).trim();
            }
            if(part) chunks.push(part);
        });
    });

    const panel=document.createElement('section');
    panel.id='ri-audio';
    panel.setAttribute('aria-label','Ascolta questo articolo');
    panel.innerHTML=`
        <div class="ri-controls">
            <button type="button" class="ri-play">▶ Ascolta la notizia</button>
            <button type="button" class="ri-pause" disabled>Pausa</button>
            <button type="button" class="ri-stop" disabled>Stop</button>
        </div>
        <div class="ri-settings">
            <button type="button" class="ri-preview">Prova voce</button>
            <label for="ri-speed">Velocità:</label>
            <select id="ri-speed">
                <option value="0.9">Più lenta</option>
                <option value="1" selected>Normale</option>
                <option value="1.1">Più veloce</option>
            </select>
        </div>
        <span class="ri-status" role="status" aria-live="polite">
            Premi Ascolta la notizia.
        </span>`;

    const firstText=Array.from(body.querySelectorAll('h2,h3,h4,p'))
        .find(el=>!el.closest(excluded));
    if(firstText) firstText.before(panel);
    else body.prepend(panel);

    const synth=window.speechSynthesis;
    const play=panel.querySelector('.ri-play');
    const pause=panel.querySelector('.ri-pause');
    const stop=panel.querySelector('.ri-stop');
    const preview=panel.querySelector('.ri-preview');
    const speed=panel.querySelector('#ri-speed');
    const status=panel.querySelector('.ri-status');

    let index=0;
    let generation=0;
    let active=false;
    let paused=false;
    let current=null;
    let sessionVoice=null;
    let sequence=[];

    try{
        const saved=localStorage.getItem('ri-audio-speed');
        if(['0.9','1','1.1'].includes(saved)) speed.value=saved;
    }catch(e){}

    function chosenVoice(){
        const voices=synth.getVoices();
        const italian=voices.filter(v=>/^it(?:[-_]|$)/i.test(v.lang));

        return italian.find(v=>/^google italiano$/i.test(v.name))
            || italian.find(v=>/google/i.test(v.name))
            || italian.find(v=>v.default)
            || italian.find(v=>v.localService)
            || italian[0]
            || null;
    }

    function controls(){
        play.disabled=active;
        pause.disabled=!active;
        stop.disabled=!active;
        preview.disabled=active;
        pause.textContent=paused?'Riprendi':'Pausa';
    }

    function cancelReading(message){
        generation++;
        active=false;
        paused=false;
        index=0;
        current=null;
        sequence=[];
        synth.cancel();
        controls();
        status.textContent=message;
    }

    function finish(message){
        active=false;
        paused=false;
        current=null;
        controls();
        status.textContent=message;
    }

    function speak(){
        if(!active || paused) return;
        if(index>=sequence.length){
            finish('Lettura terminata.');
            return;
        }

        const token=generation;
        const utterance=new SpeechSynthesisUtterance(sequence[index]);
        current=utterance;
        utterance.lang='it-IT';

        // Non blocca la lettura se manca una voce chiamata Google.
        if(sessionVoice) utterance.voice=sessionVoice;

        utterance.rate=Number(speed.value);
        utterance.pitch=1;
        utterance.volume=1;

        utterance.onstart=function(){
            if(token!==generation || !active) return;
            status.textContent='Lettura in corso.';
        };

        utterance.onend=function(){
            if(token!==generation || !active) return;
            current=null;
            index++;
            speak();
        };

        utterance.onerror=function(event){
            if(token!==generation || !active) return;
            cancelReading(
                'Lettura interrotta: '+(event.error || 'errore vocale')+
                '. Premi di nuovo Ascolta la notizia.'
            );
        };

        try{
            synth.speak(utterance);
        }catch(e){
            cancelReading('Avvio non riuscito. Premi di nuovo Ascolta la notizia.');
        }
    }

    function start(parts){
        cancelReading('Avvio della lettura…');
        sequence=parts;
        sessionVoice=chosenVoice();
        active=true;
        controls();

        // L'avvio avviene direttamente nel tocco sul pulsante.
        if(synth.paused) synth.resume();
        speak();
    }

    play.addEventListener('click',function(){
        start(chunks);
    });

    preview.addEventListener('click',function(){
        start(['Benvenuti. Puoi ascoltare le notizie in italiano.']);
    });

    pause.addEventListener('click',function(){
        if(!active) return;

        if(paused){
            paused=false;
            controls();
            status.textContent='Ripresa della lettura…';
            if(synth.paused) synth.resume();
            speak();
        }else{
            paused=true;
            generation++;
            synth.cancel();
            current=null;
            controls();
            status.textContent=
                'In pausa. Riprenderà dall’inizio del passaggio interrotto.';
        }
    });

    stop.addEventListener('click',function(){
        cancelReading('Lettura fermata.');
    });

    speed.addEventListener('change',function(){
        try{
            localStorage.setItem('ri-audio-speed',speed.value);
        }catch(e){}
        if(active){
            status.textContent='La velocità cambierà dal prossimo passaggio.';
        }
    });

    // Richiede le voci anche prima del primo tocco.
    synth.getVoices();

    window.addEventListener('pagehide',function(){
        cancelReading('Lettura fermata.');
    });
}

if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',init,{once:true});
}else{
    init();
}
})();
</script></body>
