                    /* ═══════════════════════════════════════════════════════════
                    CTA — DESKTOP (default)
                    ═══════════════════════════════════════════════════════════ */

                    .ls-cta-fonti {
                    display: flex;
                    align-items: center;
                    width: 850px;
                    margin: 0 auto;
                    text-decoration: none;
                    cursor: pointer;
                    border-radius: 10px;
                    box-shadow: 0 0 16px rgba(0,0,0,0.22);
                    overflow: hidden;
                    }

                    .ls-cta-fonti__band {
                    background: #F15327;
                    padding: 10px 20px;
                    color: #ffffff;
                    font-family: 'Open Sans', sans-serif;
                    font-weight: 700;
                    font-size: 20px;
                    line-height: 1.3;
                    border-top: 8px solid transparent;
                    border-image: linear-gradient(to right,
                        #4285F4 0%  25%,
                        #EA4335 25% 50%,
                        #FBBC05 50% 75%,
                        #34A853 75% 100%) 1;
                    }

                    .ls-cta-fonti__body {
                    display: flex;
                    align-items: center;
                    gap: 14px;
                    padding: 12px 20px;
                    background: #ffffff;
                    transition: background .18s;
                    }

                    .ls-cta-fonti__icon {
                    flex-shrink: 0;
                    width: 44px;
                    height: 44px;
                    }
                    .ls-cta-fonti__icon svg { width: 100%; height: 100%; display: block; }

                    .ls-cta-fonti__text {
                    flex: 1;
                    min-width: 0;
                    color: #202124;
                    font-family: 'Open Sans', sans-serif;
                    font-weight: 400;
                    font-style: italic;
                    font-size: 18px;
                    line-height: 1.3;
                    }

                    /* i <br> e il row-break sono nascosti su desktop */
                    .ls-cta-fonti__br       { display: none; }
                    .ls-cta-fonti__row-break { display: none; }

                    .ls-cta-fonti__badge {
                    flex-shrink: 0;
                    background: #4285F4;
                    color: #ffffff;
                    font-family: 'Open Sans', sans-serif;
                    font-weight: 700;
                    font-size: 19px;
                    padding: 8px 20px;
                    border-radius: 24px;
                    white-space: nowrap;
                    margin: 0;
                    transition: background .18s, box-shadow .18s;
                    box-shadow: 0 1px 3px rgba(66,133,244,.35);
                    }
                    .ls-cta-fonti:hover .ls-cta-fonti__badge {
                    background: #1a73e8;
                    box-shadow: 0 3px 10px rgba(66,133,244,.45);
                    }

                    /* ═══════════════════════════════════════════════════════════
                    CTA — MOBILE (max-width: 480px) — box fisso 300×250
