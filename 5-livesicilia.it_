di .icon { color: var(--main-color); margin: 0px 4px; }.widget-title span:hover { color: var(--main-color)!important }.nopadding { padding: 0; }.nopadding-left { padding-left: 0; }.nopadding-right { padding-right: 0; }.transition { transition: all 1s ease-in-out; }.fast-transition { transition: all .5s ease-in-out; }.preload * { -webkit-transition: none !important; -moz-transition: none !important; -ms-transition: none !important; -o-transition: none !important; transition: none !important; }.image-layer {padding-bottom: 56.25%; background-size: cover!important; background-position: center!important; }.square-layer {padding-bottom: 100%;}hr.is-dashed { border-bottom: 1px dashed #ccc;background-color: transparent;margin: 10px 0;border-top: 0;}hr.is-orange { border-top: 3px solid #f25217; }hr.is-grey { border-top: 1px solid #ccc; } hr.is-perizona { border-top: 3px solid #ed008a!important; } .over-flex { position: absolute; bottom: -24px;}.button.is-primary { background-color: var(--main-color); border-color: transparent; color: var(--white); width: auto; }.meta.right{ justify-content: end; }#search-form-container {position: fixed;top: 0;left: 0;right: 0;bottom: 0;z-index: 9999999999;background: #00000099;display: none;}#search-form {position: absolute;top: 50%;left: 50%;width: 80%;transform: translate(-50%, -50%);}#search-form div {position: relative;}#search-form input[type="text"] {line-height: 90px!important;background-color: #fff!important;border-radius: 1000px!important;width: 100%!important;display: table!important;margin: 0 auto!important;padding: 0!important;border-width: 0!important;z-index: 6000!important;padding: 0 100px!important;font-size: 24px!important;color: #9e9e9e!important;font-weight: 300!important;font-style: normal!important;box-shadow: 1px 4px 8px 1px rgb(0 0 0 / 20%)!important;margin: 10px 0!important;outline: 0;}#searchsubmit {position: absolute;right: 0;top: 50%;left: 45px;transform: translate(0px, -50%);background: transparent;border: 0px;color: #b3b3b3;font-size: 18px;width: 30px;}#close-search {position: absolute;top: 50%;right: 45px;transform: translate(0px, -50%);background: transparent;border: 0px;color: #b3b3b3;font-size: 18px;outline: 0;}#site-header {background: var(--main-color);color: var(--white);box-shadow: 0 2px 5px 0 rgb(0 0 0 / 20%);}#site-header a {padding: 8px 12px;display: block;color: var(--white);font-size: 12px;-webkit-transition: color .2s ease-in-out, background .2s ease-in-out;-moz-transition: color .2s ease-in-out, background .2s ease-in-out;-ms-transition: color .2s ease-in-out, background .2s ease-in-out;-o-transition: color .2s ease-in-out, background .2s ease-in-out;transition: color .2s ease-in-out, background .2s ease-in-out;cursor: pointer;}#site-header a:hover {color: var(--main-color);background: var(--white);transition: color .2s ease-in-out, background .2s ease-in-out;}#white-site-logo {padding: 0!important;}#white-site-logo:hover {background: none!important;}#sections {float: left;box-shadow: 1px 0px 0px var(--white);}#white-logo {float: left;width: 73px;margin: 8.23px;}#search {box-shadow: -1px 0px 0px white;cursor: pointer;}#search i {margin: 2px;}#side-menu {display: none;padding: 0;list-style-type: none;margin: 0;position: absolute;top: 41px;left: -1px;background: #f15327;z-index: 999;}#main-menu {margin: 0px 0px 0px 30px;padding: 0;list-style-type: none;}.search-toggle {margin-left: auto;border-left: 1px solid var(--white);}.navbar-item.menu-sezioni-toggle {border-right: 1px solid var(--white);color: var(--white)!important;}#main-menu li {float: left;display: flex;align-items: center;padding: 6px 10px;}#main-menu li a {position: relative;color: var(--white);font-size: 12px;}#main-menu li a::after {content: "";width: 1px;height: 100%;background: var(--white);position: absolute;top: 50%;right: -10px;transform: translate(0px, -50%);}#main-menu li:last-child a::after {display: none;}#site-logo {max-width: 470px;width: 100%;margin-bottom: 4px;}#fondato-da {color: var(--main-color);}#last-update {color: #7a7a7a !important;text-transform: uppercase;font-weight: 700;}#site-footer #site-logo {margin: 20px auto;}#site-footer #main-menu {background: var(--main-color);display: block;margin: 0 auto;position: relative;float: left;width: 100%;}#site-footer #main-menu li {display: inline-block;float: none;}#site-footer #main-menu a {padding: 8px 12px;display: block;color: var(--white);font-size: 12px;-webkit-transition: color .2s ease-in-out, background .2s ease-in-out;-moz-transition: color .2s ease-in-out, background .2s ease-in-out;-ms-transition: color .2s ease-in-out, background .2s ease-in-out;-o-transition: color .2s ease-in-out, background .2s ease-in-out;transition: color .2s ease-in-out, background .2s ease-in-out;}#site-footer #main-menu a:hover {color: var(--main-color);background: var(--white);transition: color .2s ease-in-out, background .2s ease-in-out;}#site-footer p {margin-bottom: 20px;font-size: 12px;} .apertura a {color: var(--black);}.apertura .author-meta a{color: var(--main-color);}.apertura h2 {font-size: 42px;margin: 0;margin-bottom: 10px;}.meta {font-weight: bold;text-transform: uppercase;font-size: 12px;line-height: 12px;margin: 10px 0;line-height: 1;display: flex;align-items: center;}.meta-divider-vertical {width: 2px;height: 1em;background: #000;margin: 0 5px;}.author-meta,.author-meta a {text-transform: initial;color: var(--ghost);font-weight: normal;}.apertura p {font-size: 16px;line-height: 20.8px;margin-bottom: 0;} .row.mosaico {display: flex;flex-wrap: wrap; } .row.mosaico .mini {display: flex;justify-content: space-between;-webkit-flex: 1 1 auto;flex: 1 1 auto;margin-bottom: 10px; } .mosaico h2 {margin: 0;font-size: 20px;color: var(--black);margin-top: 10px;}.foto-e-video.mosaico h2 {font-size: 12px;} .mosaico p {font-size: 13px;margin: 0;margin-bottom: 20px;min-height: 32px;display: -webkit-box;-webkit-line-clamp: 2;-webkit-box-orient: vertical;overflow: hidden;text-overflow: ellipsis;min-height: 37px; } .widget-title {margin: 0;font-size: 32px;text-align: center;font-weight: bold;margin-bottom: 12px;position: relative;}.widget-title span {background: var(--white);position: relative;padding: 0px 15px;z-index: 1;}.widget-title::before { content: "";position: absolute;top: 50%;left: 0;width: 100%;height: 3px;background: var(--main-color);}.sezioni {display: flex;flex-wrap: wrap;}.sezioni .mini {display: flex;justify-content: space-between;-webkit-flex: 1 1 auto;flex: 1 1 auto;margin-bottom: 20px;}.sezioni .mini.reset {padding-bottom: 15px;margin-bottom: 10px;}.sezioni .mini {padding-bottom: 25px;margin-bottom: 25px;}.sezioni h2 {font-size: 16px;margin: 0;line-height: 18px;}.sezioni a,.mosaico a {color: var(--black);}.sezioni p {font-size: 12px;margin: 0;}.post-author-date {font-size: 9.6px;}.post-author-date a { color: var(--main-color);}.meta-small {font-weight: bold;text-transform: uppercase;font-size: 9.6px;line-height: 12.48px;margin-bottom: 5px;}h2.as-mosaico {margin: 0;font-size: 20px;color: var(--black);margin-top: 10px;} #breadcrumbs {display: flex;flex-direction: row;justify-content: center;margin-bottom: 20px!important;font-family: open sans condensed;line-height: 1;font-weight: 700;margin-top: 20px;font-size: 20px;}#breadcrumbs a { color: var(--main-color);}#breadcrumbs:after {flex-grow: 1;height: 2px;content: '\a0';background-color: #ccc;position: relative;top: 0.5em;margin-left: 10px;} .perizona h2 {margin-bottom: 10px; } .row.mosaico.perizona .mini {margin-bottom: 0px; } .row.mosaico.perizona hr {border-color: #ed008a;margin-top: 5px; }.line-image-left.line-perizona-background h3 {position: relative;}.line-image-left.line-perizona-background img {height: 20px!important;z-index: 9999;background: #fff;padding-right: 10px;}.line-image-left.line-perizona-background h3::after {content: "";position: absolute;top: 50%;width: 100%;background: #ed008a;height: 3px;left: 0;z-index: -1;} .single h1 { font-size: 33px; margin-bottom: 24px; letter-spacing: -.5px;}.s