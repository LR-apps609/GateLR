			<script>
			
			
			
							let vociMenuMob = document.querySelectorAll('ul#header-menu li a');

				vociMenuMob.forEach(voce => {
					voce.addEventListener('click', (event) => {
						let link = voce; // Il link è direttamente il nodo `a`

						if (link.target === '_blank') {
							return; // Se è un link che si apre in una nuova scheda, non bloccare l'azione
						}

						event.preventDefault(); // Previene la navigazione immediata

						gtag('event', 'track_navigation', {
							'event_label': 'Navigation',
							'event_type_cat': 'menu-hamburger-' + link.textContent.trim().replace(/\s+/g, '-')
						});

						setTimeout(() => {
							window.location.href = link.href;
						}, 200); // Ritardo per garantire il tracciamento
					});
				});
								
									let vociMenuDsk = document.querySelectorAll('ul#main-menu li a');

					vociMenuDsk.forEach(voce => {
						voce.addEventListener('click', (event) => {
							let link = voce; // Il nodo <a> è già il link

							if (link.target === '_blank') {
								return; // Se il link si apre in una nuova scheda, non bloccare l'azione
							}

							event.preventDefault(); // Previene la navigazione immediata

							gtag('event', 'track_navigation', {
								'event_label': 'Navigation',
								'event_type_cat': 'menu-orizzontale-' + link.textContent.trim().replace(/\s+/g, '-')
							});

							setTimeout(() => {
								window.location.href = link.href;
							}, 200); // Ritardo per garantire il tracciamento prima del cambio pagina
						});
					});

						
		</script>
				
