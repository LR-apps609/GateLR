                                            type="radio"
                                            id="radio-8"
                                        />
                                        <label for="radio-8" data-element="feedback-rating-answer"
                                            >A volte non capivo se stavo procedendo correttamente</label
                                        >
                                        </div>
                                        <div
                                        class="radio-body border-bottom border-light cmp-radio-list__item"
                                        >
                                        <input
                                            name="rating2"
                                            type="radio"
                                            id="radio-9"
