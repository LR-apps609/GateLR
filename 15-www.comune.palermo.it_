			a {
    vertical-align: top;
}
.row-calendar .it-calendar-wrapper .card .card-text a:hover {
 text-decoration:none;
}
.row-calendar .it-calendar-wrapper .card .card-text img {
    width: 100%;
    height: 54px;
	  object-fit: cover;

}
a.card-bg-primary:hover{
filter: brightness(0.8); 
}
.img-fluid {
    width: 100%;
	  height:100%;
	  object-fit: cover;
	  max-height:550px;
}
.it-footer .logo-wrapper .ue-logo {
    max-width: 50%;
	  width:220px;
	  height:100%;
}
.callout {
    padding: 2.5rem 2.222rem;
    border: 2px solid #999;
    position: relative;
    max-width: 100%;
    margin: 1.75rem 0 1rem;
    border-radius: 8px;
	  overflow: visible;
}
.callout:not(.callout-highlight):not(.callout-more) .callout-title {
    position: absolute!important;
    font-size: 1rem;
    padding: 0 1.389rem;
    background: #fff;
    top: -0.78em;

}
.callout:not(.callout-highlight):not(.callout-more) .callout-title:before {
    width: 0rem;
}
.callout p {
    font-family: Lora,Georgia,serif;
    font-size: .9rem;
	  color:#191919;

}
.callout .callout-title .icon {
    fill: #191919;
}

ul.sitemap {
    list-style-type: none;
    padding-left: 20px;
}
ul.sitemap > li > a {
    font-weight: bold;
    text-decoration: none;

}
ul.sitemap ul.sub-menu > li > a {
    font-weight: normal;

	 text-decoration: none;
    padding-left: 10px;
}
ul.sitemap a.current_page_item {
    color: #000;
}
ul.sitemap ul.sub-menu {
    list-style-type: none;
    padding-left: 20px;
}
ul.sitemap > li {
    border-bottom: 1px solid #ccc;
    padding-bottom: 5px;
    margin-bottom: 5px;
}
ul.sitemap ul.sub-menu {
    display:  block;
}
ul.sitemap li:hover > ul.sub-menu {
    display: block;
}
ul.pnrrmap {
    list-style-type: none;
    padding-left: 0px;
}

ul.pnrrmap > li > a {
    font-weight: bold;
    text-decoration: none;
}
ul.pnrrmap ul.sub-menu > li > a {
    font-weight: normal;
    text-decoration: none;
    padding-left: 10px;	

}
ul.pnrrmap a.current_page_item {
    color: #000; 
}
ul.pnrrmap ul.sub-menu {
    list-style-type: none;
    padding-left: 20px;
	  padding-bottom: 10px;
	  padding-top: 8px;	

}
ul.pnrrmap > li {
    border-bottom: 0px solid #ccc;
    padding-bottom: 20px;
    margin-bottom: 10px;
}
ul.pnrrmap ul.sub-menu {
    display: block;
}
ul.pnrrmap li:hover > ul.sub-menu {
    display: block;
}

.pnrrcontent {
	margin-top:-25px!important;
}
.pnrrtitolo {
		  padding-top: 25px;
}
blockquote, .blockquote {
    border-left: 4px solid rgba(0, 122, 82, .1);
}
.squarelist ul {
    padding-left: 2.0rem;
	  padding-bottom: 1rem;
	  list-style-type: square;
}
.squarelist ol{
    padding-left: 1.8rem;
	  padding-bottom: 1rem;
	  list-style-type: decimal;
}
.squarelist li {
    margin-bottom: 8px;
}
.imgpage img {
    max-width: 100%; 
    height: auto;
}
