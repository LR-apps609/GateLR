
	h3.footer-heading-title {
		font-size: 16px
	}


.footer-items-wrapper.logo-wrapper {
  display: flex;
  align-items: center;   /* allinea verticalmente */
  gap: 1rem;             /* spazio tra i loghi e il testo */
}

.footer-items-wrapper.logo-wrapper a {
  display: flex;
  align-items: center;
  text-decoration: none;
}

.ue-logo {
  height: 60px;
  width: auto;
}

.it-brand-wrapper {
  display: flex;
  align-items: center;
}

.it-brand-text h2 {
  margin: 0 0 0 0.5rem;
  font-size: 1.2rem;
  color: white; /* cambia colore se necessario */
}


.it-brand-logo {
	  height :48px;
  width: auto;
  object-fit: contain;
	margin-left: 20px;
}


@media (min-width: 992px) {
.it-brand-logo {
	  height :82px;
  width: auto;
  object-fit: contain;
}

}

.nav-link {
	  font-weight: bold!important;

}


