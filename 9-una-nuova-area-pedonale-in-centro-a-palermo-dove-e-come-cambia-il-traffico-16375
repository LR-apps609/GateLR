    <script>
        // Variabili richieste
        let provincia = "";
        let quando = "";
        let tipologia = "tutti-gli-eventi";

        const provinceItems = [
            ["Palermo", "a-palermo-e-provincia"],
            ["Trapani", "a-trapani-e-provincia"],
            ["Agrigento", "ad-agrigento-e-provincia"],
            ["Caltanissetta", "a-caltanissetta-e-provincia"],
            ["Enna", "ad-enna-e-provincia"],
            ["Messina", "a-messina-e-provincia"],
            ["Catania", "a-catania-e-provincia"],
            ["Siracusa", "a-siracusa-e-provincia"],
            ["Ragusa", "a-ragusa-e-provincia"],
            ["Sicilia", "in-sicilia"]
        ];

        const quandoItems = [
            ["Oggi", "di-oggi"],
            ["Domani", "di-domani"],
            ["Weekend", "del-weekend"],
            ["Questa settimana", "di-questa-settimana"],
            ["Prossima settimana", "della-prossima-settimana"]
        ];

        const tipologiaItems = [
            ["Tutti", "tutti-gli-eventi"]
        ];

        const mesiItaliani = [
            "Gennaio",
            "Febbraio",
            "Marzo",
            "Aprile",
            "Maggio",
            "Giugno",
            "Luglio",
            "Agosto",
            "Settembre",
            "Ottobre",
            "Novembre",
            "Dicembre"
        ];

        /**
         * Converte il testo in kebab-case.
         * Esempio: "Novembre 2026" → "novembre-2026"
         */
        function toKebabCase(value) {
            return value
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "")
                .toLowerCase()
                .trim()
                .replace(/[^a-z0-9]+/g, "-")
                .replace(/^-+|-+$/g, "");
        }

        /**
         * Aggiunge il mese corrente e i cinque mesi successivi.
         */
        function aggiungiMesi() {
            const dataCorrente = new Date();

            const offsetMese = dataCorrente.getDate() <= 15 ? 0 : 1;

            const dataMese = new Date(
                dataCorrente.getFullYear(),
                dataCorrente.getMonth() + offsetMese,
                1
            );

            const testo = [
                mesiItaliani[dataMese.getMonth()],
                dataMese.getFullYear()
            ].join(" ");

            quandoItems.push([
                testo,
                "di-" + toKebabCase(testo)
            ]);

            quandoItems.push([
                'Prossimi mesi',
                'dei-prossimi-mesi'
            ]);
        }

        aggiungiMesi();

        const menuConfig = [
            {
                buttonId: "luogo-button",
                menuId: "luogo-menu",
                labelId: "luogo-label",
                items: provinceItems,
                setValue(value) {
                    provincia = value;
                    aggiornaTipologieDisponibili();
                }
            },
            {
                buttonId: "quando-button",
                menuId: "quando-menu",
                labelId: "quando-label",
                items: quandoItems,
                setValue(value) {
                    quando = value;
                    aggiornaTipologieDisponibili();
                }
            },
            {
                buttonId: "tipologia-button",
                menuId: "tipologia-menu",
                labelId: "tipologia-label",
                items: tipologiaItems,
                setValue(value) {
                    tipologia = value;
                }
            }
        ];

        function resetTipologia(items = [["Tutti", "tutti-gli-eventi"]]) {
            const config = menuConfig.find((item) => item.menuId === "tipologia-menu");
            config.items = items;
            tipologia = "tutti-gli-eventi";
            document.getElementById("tipologia-label").textContent = "Tutti";
            creaMenu(config);
        }

        function aggiornaTipologieDisponibili() {
            if (!provincia || !quando) {
                resetTipologia();
                return;
            }

            const params = new URLSearchParams({ provincia, quando });

            fetch("/ajax/categorie-eventi-disponibili?" + params.toString(), {
                method: "GET",
                headers: {
                    "X-Requested-With": "XMLHttpRequest",
                    "Accept": "application/json"
                },
                credentials: "same-origin"
            })
                .then((response) => {
                    if (!response.ok) {
                        throw new Error("Errore nel caricamento delle tipologie");
                    }
                    return response.json();
                })
                .then((categorie) => {
                    const items = [["Tutti", "tutti-gli-eventi"]];

                    categorie.forEach((categoria) => {
                        if (Array.isArray(categoria) && categoria.length === 2) {
                            items.push(categoria);
                        }
                    });

                    resetTipologia(items);
                })
                .catch(() => {
                    resetTipologia();
                });
        }

        function chiudiTuttiIMenu(menuDaEscludere = null) {
            menuConfig.forEach((config) => {
                const menu = document.getElementById(config.menuId);
                const button = document.getElementById(config.buttonId);

                if (menu !== menuDaEscludere) {
                    menu.style.display = "none";
                    button.setAttribute("aria-expanded", "false");
                }
            });
        }

        function creaMenu(config) {
            const button = document.getElementById(config.buttonId);
            const menu = document.getElementById(config.menuId);
            const label = document.getElementById(config.labelId);

            menu.innerHTML = "";
            const ul = document.createElement("ul");

            ul.style.listStyle = "none";
            ul.style.margin = "0";
            ul.style.paddingLeft = "10px";
            ul.style.paddingRight = "25px";
            ul.style.textAlign = "left";

            config.items.forEach(([testo, valore]) => {
                const li = document.createElement("li");
                const link = document.createElement("a");

                li.style.minHeight = "30px";
                li.style.display = "flex";
                li.style.alignItems = "center";

                link.href = "#";
                link.textContent = testo;
                link.dataset.value = valore;

                link.style.color = "#666";
                link.style.textDecoration = "none";
                link.style.whiteSpace = "nowrap";
                link.style.cursor = "pointer";

                link.addEventListener("mouseenter", () => {
                    link.style.color = "#f31323";
                });

                link.addEventListener("mouseleave", () => {
                    link.style.color = "#666";
                });

                link.addEventListener("click", (event) => {
                    event.preventDefault();
                    event.stopPropagation();

                    config.setValue(valore);
                    label.textContent = testo;

                    menu.style.display = "none";
                    button.setAttribute("aria-expanded", "false");
                });

                li.appendChild(link);
                ul.appendChild(li);
            });

            menu.appendChild(ul);

            if (!button.dataset.menuListenerBound) {
                button.addEventListener("click", (event) => {
                    event.stopPropagation();

                    if (config.buttonId === "tipologia-button" && (!provincia || !quando)) {
                        chiudiTuttiIMenu();
                        alert("Seleziona prima il luogo \"Scegli dove\" e poi il periodo \"Scegli quando\".");
                        return;
                    }

                    const menuAperto = menu.style.display === "block";

                    chiudiTuttiIMenu(menu);

                    menu.style.display = menuAperto ? "none" : "block";
                    button.setAttribute(
                        "aria-expanded",
                        menuAperto ? "false" : "true"
                    );
                });
                button.dataset.menuListenerBound = "1";
            }

            if (!menu.dataset.menuListenerBound) {
                menu.addEventListener("click", (event) => {
                    event.stopPropagation();
                });
                menu.dataset.menuListenerBound = "1";
            }
        }

        menuConfig.forEach(creaMenu);

        // Chiude i menu facendo click fuori.
        document.addEventListener("click", () => {
            chiudiTuttiIMenu();
        });

        document
            .getElementById("cerca-button")
            .addEventListener("click", () => {
                chiudiTuttiIMenu();

                if (!provincia || !quando) {
                    alert("Seleziona prima il luogo \"Scegli dove\" e poi il periodo \"Scegli quando\".");
                    return;
                }

                const url =
                    "/" +
                    tipologia + "-" +
                    provincia + "-" +
                    quando;

                window.location.href = url;
            });
    </script>

            
