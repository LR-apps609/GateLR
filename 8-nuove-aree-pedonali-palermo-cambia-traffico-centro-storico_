<style id="blockcraft-google-discover-badge-style-inline-css">
.bc-google-cta{
    display: flex;
    align-items: center;
    justify-content: flex-start !important;
    gap: 24px;
    padding: 10px 0;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
}

.bc-google-cta__label{
    font-family: Arial, Helvetica, sans-serif;
    font-size: 16px;
    font-weight: normal;
}

.bc-google-cta__actions{
    display: flex;
    gap: 24px;
}

.bc-google-cta__button{
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    border-radius: 6px;
    border: 1px solid rgba(0, 0, 0, 0.2);

    &:hover{
        background-color: rgba(0, 0, 0, 0.03);
    }

    .bc-google-cta__icon{
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .bc-google-cta__text{
        font-family: Arial, Helvetica, sans-serif;
        font-size: 16px;
        font-weight: normal;

        strong{
            font-weight: 600;
        }
    }

    &.bc-google-cta__button--preferred{
        background-color: #1A1A1A;
        color: #fff;

        &:hover{
            background-color: #202020;
        }
    }
}

/* Pulsante "Fonte preferita" di Google: i valori vengono iniettati nel suo Shadow DOM da view.js */
.bc-google-cta__preferred{
    --bc-gcta-height: 40px;
    --bc-gcta-radius: 6px;
    --bc-gcta-padding-x: 16px;
    --bc-gcta-icon-size: 16px;
    --bc-gcta-font: Arial, Helvetica, sans-serif;
    --bc-gcta-font-size: 16px;
    --bc-gcta-font-weight: normal;

    /* Spazio riservato prima che publisher.js (caricato in lazy) renderizzi il pulsante: evita CLS */
    --bc-gcta-min-width: 240px;

    display: flex;
    align-items: center;
    min-height: var(--bc-gcta-height);
    min-width: var(--bc-gcta-min-width);

    /* Evita il flash dello stile Google prima dell'override */
    [google-add-preferred-source-btn]:not(.is-styled){
        visibility: hidden;
    }

    &.is-fallback{
        min-width: 0;
    }
}

body.post-template-single-video{
    .bc-google-cta__button{
        background-color: #fff;
    }
    .bc-google-cta__button--preferred{
        background-color: #1A1A1A;
        color: #fff;
    }
    .bc-google-cta{
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
}

@media (max-width: 1100px){
    .bc-google-cta{
       flex-direction: column;
       justify-content: center !important;
       display: flex !important;
    }

    .bc-google-cta__actions{
        flex-wrap: wrap;
        justify-content: center;
    }
}
