600 pt-4 pb-4\",\"children\":[\"$\",\"$L1d\",null,{\"href\":\"/nuova-tabella-multe-codice-strada\",\"className\":\"flex gap-4 group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex-shrink-0 w-20 h-20 rounded overflow-hidden bg-gray-200 dark:bg-gray-800\",\"children\":[\"$\",\"$L1e\",null,{\"src\":\"https://backoffice.automobilista.it/wp-content/uploads/2026/09/multe-2026-marciapiedi-300-e-assicurazione-pi-cara-rmto4psjc.jpg\",\"alt\":\"Silhouette of a police control area in a modern urban environment with road barriers.\",\"width\":80,\"height\":80,\"className\":\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-300\"}]}],[\"$\",\"div\",null,{\"className\":\"flex-1 min-w-0\",\"children\":[\"$\",\"p\",null,{\"className\":\"text-gray-900 dark:text-gray-100 font-medium text-sm leading-tight line-clamp-4 group-hover:text-[#017ac2] dark:group-hover:text-blue-400 transition-colors\",\"children\":[\"$\",\"span\",null,{\"className\":\"$undefined\",\"dangerouslySetInnerHTML\":{\"__html\":\"Multe 2026: marciapiedi +300% e assicurazione più cara — chi paga di più\"}}]}]}]]}]}]}]\n"])</script></body></html>