            jQuery(window).on("load", function() {
                mobileSlider();
                jQuery('.box-height').matchHeight();
                jQuery("#searchFormMobile").hide();
                jQuery("label[for='billing_cf']").append(' <abbr class="required" title="obbligatorio">*</abbr>');
            });
            
