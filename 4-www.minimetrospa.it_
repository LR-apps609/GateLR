                /*mobileSlider();*/
                jQuery('.box-height').matchHeight();
            });

                        function mobileSlider() {
                var windowWith = jQuery(window).width();
                if (windowWith <= 980) { 
                    var altezzaBox = jQuery(".c2i_slider_container").children().height();
                    altezzaBox = altezzaBox + 50;
                    jQuery(".c2i_slide").css("margin-bottom", altezzaBox + "px");
                    jQuery(".c2i_slider_spacer").css("min-height", "0");
                    var altezzaSpacer = (jQuery(".c2i_slider_spacer").height() - 30);
                    jQuery(".et-pb-controllers").css("top", altezzaSpacer + "px");
                    jQuery(".et-pb-controllers").css("bottom", "unset");
                    //jQuery(".c2i_slide").css("max-height", "158px");
                    var altezzaSpacer = jQuery(".c2i_slider_spacer").height();
                    var altezzaArrow = (altezzaSpacer / 2) - 20;
                    jQuery(".et-pb-arrow-prev").css("top", altezzaArrow + "px");
                    jQuery(".et-pb-arrow-next").css("top", altezzaArrow + "px");
                    var spaziatore = 104;
                    if (windowWith <= 359) {
                        var spaziatore = 152;    
                    }
                    else if (windowWith <= 389) {
                        var spaziatore = 140;    
                    }
                    else if (windowWith <= 497) {
                        var spaziatore = 128;    
                    }
                    else if (windowWith <= 616) {
                        var spaziatore = 114;    
                    }
                    altezzaSpacer = (altezzaSpacer + spaziatore) * +1;
                    jQuery(".c2i_slider_container").css("top", altezzaSpacer + "px");
                }
                else {
                    jQuery(".c2i_slider_container").css("top", "50%");
                    jQuery(".c2i_slide").css("margin-bottom", "0");
                    jQuery(".c2i_slider_spacer").css("min-height", "300px");
                    jQuery(".et-pb-controllers").css("top", "unset");
                    jQuery(".et-pb-controllers").css("bottom", "5%");
                    /*jQuery(".et-pb-arrow-prev").css("top", "unset");
                    jQuery(".et-pb-arrow-next").css("top", "unset");*/
                }
            }
                            
            function searchBar() {
                if (jQuery("#searchFormMobile").is(":visible")) {
                    jQuery("#searchFormMobile").hide();
                }
                else {
                    jQuery("#searchFormMobile").show();
                }
            }
        </script>
	
