    margin:        auto;
    padding:       36px 32px 32px;
    overflow:      hidden;
    border-radius: 2px;
    box-shadow:    var( --global-shadow, .3rem .3rem 1rem 0 rgba( 13, 13, 13, .2 ) );
  }

  .unfair-skip
  {
    position:        absolute;
    top:             10px;
    right:           10px;
    display:         flex;
    align-items:     center;
    justify-content: center;
    width:           32px;
    height:          32px;
    padding:         0;
    background:      none;
    border:          0;
    border-radius:   2px;
    cursor:          pointer;
    opacity:         .7;
    transition:      opacity .3s ease-out;
  }

  .unfair-skip:hover
  {
    opacity: 1;
  }

  .unfair-skip:focus-visible
  {
    outline:        2px solid currentColor;
    outline-offset: 0;
    opacity:        1;
  }

  .unfair-skip svg
  {
    display:    block;
    width:      16px;
    height:     16px;
    transition: transform .3s cubic-bezier( .34, 1.56, .64, 1 );
  }

  .unfair-skip:hover svg,
  .unfair-skip:focus-visible svg
  {
    transform: rotate( 90deg );
  }

  .unfair-skip:active svg
  {
    transform: rotate( 90deg ) scale( .85 );
  }

  @media ( prefers-reduced-motion: reduce )
  {
    .unfair-skip svg
    {
      transition: none;
    }

    .unfair-skip:hover svg,
    .unfair-skip:focus-visible svg,
    .unfair-skip:active svg
    {
      transform: none;
    }
  }

  .unfair-bar
  {
    position: absolute;
    top:      0;
    right:    0;
    left:     0;
    height:   4px;
  }

  .unfair-title
  {
    margin:      0 0 8px;
    padding:     0 32px 0 0;
    font-family: var( --font-serif-display, Georgia, Times, "Times New Roman", serif );
    font-weight: 700;
    font-size:   1.75rem;
    line-height: calc( 1em + 4px );
    color:       inherit;
  }

  .unfair-text
  {
    margin: 0 0 24px;
  }

  .unfair-options
  {
    display:               grid;
    grid-template-columns: repeat( 2, 1fr );
    gap:                   16px;
  }

  .unfair-option
  {
    display:        flex;
    flex-direction: column;
    padding:        20px;
    border-radius:  2px;
  }

  @supports ( grid-template-rows: subgrid )
  {
    .unfair-option
    {
      display:            grid;
      grid-row:           span 3;
      grid-template-rows: subgrid;
      row-gap:            0;
    }
  }

  .unfair-option-title
  {
    margin:      0 0 6px;
    font-family: var( --font-sans-grotesk, system-ui, Arial, "Helvetica Neue", Helvetica, sans-serif );
    font-weight: 900;
    font-size:   1.25rem;
    line-height: calc( 1em + 4px );
    color:       inherit;
  }

  .unfair-option-text
  {
    flex:      1;
    margin:    0 0 16px;
    font-size: 0.95rem;
  }

  .unfair-action
  {
    display:         flex;
    align-items:     center;
    justify-content: center;
    width:           100%;
    min-height:      48px;
    font-family:     var( --font-sans-grotesk, system-ui, Arial, "Helvetica Neue", Helvetica, sans-serif );
    font-weight:     700;
    font-size:       1rem;
    line-height:     1.25;
    text-align:      center;
    text-decoration: none;
    cursor:          pointer;
  }

  [data-theme="today"] .unfair-action.c-btn--evidence,
  [data-theme="ruby"] .unfair-action.c-btn--evidence,
  [data-theme="blue"] .unfair-action.c-btn--evidence,
  [data-theme="fuchsia"] .unfair-action.c-btn--evidence
  {
    --btn-label: #fff;
  }

  [data-theme="red"] .unfair-action.c-btn--evidence
  {
    --btn-color: var( --theme-color-dark );
    --btn-label: #fff;
  }

  [data-theme="red"] .unfair-action.c-btn--evidence:hover
  {
    --btn-color: var( --theme-color-darker );
  }

  [data-color-scheme*="dark"][data-theme="today"] .unfair-action.c-btn--evidence
  {
    --btn-color: var( --theme-color-light );
  }

  [data-color-scheme*="dark"][data-theme="today"] .unfair-bar
  {
    background-color: var( --theme-color-light );
  }

  .unfair-login
  {
    margin:     20px 0 0;
    font-size:  0.95rem;
    text-align: center;
  }

  .unfair-login a
  {
    font-weight:     700;
    text-decoration: underline;
  }

  .unfair-login a:focus-visible
  {
    outline:        3px solid currentColor;
    outline-offset: 2px;
  }

  @media ( max-width: 720px )
  {
    .unfair-panel
    {
      padding: 28px 20px 24px;
    }

    .unfair-title
    {
      font-size: 1.625rem;
    }

    .unfair-options
    {
      grid-template-columns: 1fr;
    }
  }

  @media ( max-width: 400px ), ( max-height: 700px )
  {
    [data-unfair]
    {
      padding: 12px;
    }

    .unfair-panel
    {
      padding: clamp( 24px, 4.5vh, 32px ) 18px clamp( 18px, 3.5vh, 26px );
    }

    .unfair-skip
    {
      top:   8px;
      right: 8px;
    }

    .unfair-title
    {
      margin:    0 0 clamp( 8px, 1.5vh, 12px );
      font-size: 1.3rem;
    }

    .unfair-text
    {
      margin:      0 0 clamp( 14px, 3vh, 22px );
      font-size:   0.875rem;
      line-height: 1.45;
    }

    .unfair-options
    {
      gap: clamp( 10px, 2.2vh, 16px );
    }

    .unfair-option
    {
      padding: clamp( 14px, 2.6vh, 20px ) 16px;
    }

    .unfair-option-title
    {
      margin:    0 0 clamp( 4px, 1vh, 8px );
      font-size: 1.05rem;
    }

    .unfair-option-text
    {
      margin:      0 0 clamp( 10px, 2vh, 16px );
      font-size:   0.8125rem;
      line-height: 1.45;
    }

    .unfair-action
    {
      min-height: 44px;
      padding:    .5rem 1rem;
      font-size:  0.9375rem;
    }

    .unfair-login
    {
      margin:    clamp( 14px, 2.6vh, 20px ) 0 0;
      font-size: 0.875rem;
    }
  }

  @media ( max-height: 520px ), ( max-width: 340px ) and ( max-height: 600px )
  {
    .unfair-option-text
    {
      display: none;
    }

    .unfair-option-title
    {
      margin: 0 0 10px;
    }
  }

  @media ( max-height: 520px )
  {
    .unfair-panel
    {
      padding: 20px 16px 14px;
    }

    .unfair-text
    {
      margin:    0 0 12px;
      font-size: 0.8125rem;
    }

    .unfair-options
    {
      gap: 8px;
    }

    .unfair-option
    {
      padding: 12px 14px;
    }

    .unfair-login
    {
      margin: 12px 0 0;
    }
  }
</style>


<div data-unfair hidden tabindex="-1" role="dialog" aria-modal="true" aria-label="Ci stai leggendo con un adblocker">
  <div class="unfair-panel o-bg-base u-color-base">
    <div class="unfair-bar o-bg-primary" aria-hidden="true"></div>
    <button class="unfair-skip u-color-secondary" type="button" aria-label="Chiudi" data-unfair--close data-unfair--track="skip"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 3l10 10M13 3L3 13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
    <h2 class="unfair-title">Ci stai leggendo con un adblocker</h2>
    <p class="unfair-text u-color-secondary">Raccontiamo la tua città ogni giorno, con una redazione sul territorio. La pubblicità ci permette di offrire gratuitamente gran parte del nostro lavoro: scegli come continuare a leggerci.</p>

    <div class="unfair-options">
     <!-- <div class="unfair-option o-bg-gray">
        <h3 class="unfair-option-title">Disattiva l'adblocker</h3>
        <p class="unfair-option-text u-color-secondary">Aggiungi il sito alle eccezioni e ricarica la pagina.</p>
        <button class="unfair-action c-btn c-btn--secondary c-btn--large" type="button" data-unfair--reload data-unfair--track="refresh">Fatto, ricarica</button>
      </div>-->

      <div class="unfair-option o-bg-gray">
        <h3 class="unfair-option-title">Abbonati</h3>
        <p class="unfair-option-text u-color-secondary">Niente pubblicità e un sostegno diretto al nostro lavoro, al prezzo di un caffè al mese.</p>
        <a class="unfair-action c-btn c-btn--evidence c-btn--large" href="/signup/premium-contents-express/WEB_BASIC_2025_02_ALL_ALL_M/?ref=unfair" data-unfair--track="buy">Scegli l'abbonamento</a>
      </div>

      <div class="unfair-option o-bg-gray">
        <h3 class="unfair-option-title">Leggi dall'app</h3>
        <p class="unfair-option-text u-color-secondary">L'app è gratuita: segui la tua città ovunque, sempre a portata di mano.</p>
        <a class="unfair-action c-btn c-btn--secondary c-btn--large" href="/~shared/do/api/mobile-app/get/?campaign=unfair" data-unfair--track="app">Scarica l'app</a>
      </div>
    </div>

    <p class="unfair-login u-color-secondary">Hai già un account? <a class="o-link-primary" href="/user/login/?ref=unfair" data-unfair--track="login">Accedi</a></p>
  </div>
</div>


