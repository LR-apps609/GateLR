:root {
  --font-serif-display: "Serif Display", Georgia, Times, Times New Roman, serif;
  --font-serif-text: "Serif Text", Georgia, Times, Times New Roman, serif;
  --font-sans-grotesk: "Sans Grotesk", system-ui, Arial, Helvetica Neue, Helvetica, sans-serif;
  --theme-color: #F2463D;
}

html, body {
  font-size: 16px;
}

body {
  margin: 0;
}

.a-programmatic {
  position: relative;
  width: 100%;
  height: 100vh;
  padding: 0;
  overflow: hidden;
  /* ratio 1.3 */
}

.a-programmatic[data-position*=in-text] {
  padding: 0.25rem 0.75rem;
  border: 1px solid var(--divider-color);
}

.a-programmatic__container {
  display: flex;
  flex-direction: column;
  background-color: var(--background-color);
  height: 100%;
}

.a-programmatic__media {
  position: relative;
  grid-area: media;
  width: 100%;
  margin: 0;
}

@media screen and (min-height: 500px) {
  .a-programmatic__media {
    flex: 1;
  }
}
[data-url="/"] .a-programmatic__media {
  min-height: 50%;
  padding-top: inherit;
  aspect-ratio: 16/9;
}

.a-programmatic__media img {
  width: 100%;
  height: 100%;
  object-position: center;
  object-fit: cover;
}

[data-url^="/"]:not([data-url="/"]) .a-programmatic__media img {
  aspect-ratio: 16/9;
}

.a-programmatic__text {
  grid-area: text;
  padding: 0.75rem;
}

[data-position*=in-text] .a-programmatic__text {
  display: block;
}

.a-programmatic__label {
  display: inline-block;
  margin-bottom: 0.5rem;
  color: var(--theme-color, #e91f63);
  text-transform: uppercase;
}

.a-programmatic__label {
  font-family: var(--font-sans-grotesk);
  font-weight: 700;
}

.a-programmatic__label {
  font-size: 0.75rem;
  line-height: calc(1em + 4px);
}

.a-programmatic__label {
  text-transform: uppercase;
}

[data-position*=in-text] .a-programmatic__label {
  display: none;
}

.a-programmatic__title {
  display: -webkit-box;
  margin-bottom: 0.5rem;
  margin-top: 0;
  color: var(--link-color-dark);
  text-decoration: none;
  -webkit-line-clamp: 5;
  line-clamp: 5;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.a-programmatic__title {
  font-family: var(--font-serif-display);
  font-weight: 500;
}

.a-programmatic__title {
  font-size: 1.25rem;
  line-height: calc(1em + 4px);
}

.a-programmatic__title:hover {
  color: #808080;
}

@media screen and (min-aspect-ratio: 2.4) and (max-aspect-ratio: 2.59) {
  .a-programmatic__title {
    line-clamp: 4;
    -webkit-line-clamp: 4;
  }
}
@media screen and (min-aspect-ratio: 2.6) and (max-aspect-ratio: 3.3) {
  .a-programmatic__title {
    line-clamp: 3;
    -webkit-line-clamp: 3;
  }
}
.a-programmatic__details {
  display: none;
}

[data-position*=in-text] .a-programmatic__details {
  display: flex;
  flex-direction: column;
  margin-top: 0.5rem;
}

.a-programmatic__cta {
  align-self: flex-start;
  margin-bottom: 0.5rem;
  padding: 0.5rem;
  border-radius: 40px;
  background-color: #148be6;
  box-shadow: 0 0 0 1px var(--btn-color);
  color: #fff;
  cursor: pointer;
}

.a-programmatic__cta {
  font-family: var(--font-sans-grotesk);
  font-weight: 700;
}

.a-programmatic__cta {
  font-size: 0.875rem;
  line-height: calc(1em + 4px);
}

.a-programmatic__cta:empty {
  display: none;
}

.a-programmatic__info {
  align-self: flex-end;
  color: var(--body-secondary-color);
}

.a-programmatic__info {
  font-family: var(--font-sans-grotesk);
  font-weight: 400;
}

.a-programmatic__info {
  font-size: 0.75rem;
  line-height: calc(1em + 4px);
}

.a-programmatic .o-faux-link {
  display: block;
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

@media screen and (min-aspect-ratio: 0.7) {
  .a-programmatic__media {
    flex: unset;
  }
}
@media screen and (min-aspect-ratio: 19/40) and (min-height: 400px) {
  .a-programmatic__media {
    flex: 1;
  }
  .a-programmatic__title {
    font-size: 1.5rem;
  }
}
@media screen and (min-aspect-ratio: 1.55) {
  .a-programmatic__container {
    flex-direction: row;
  }
  .a-programmatic__media {
    height: 100%;
    width: 40%;
    aspect-ratio: 1;
  }
  [data-position*=in-text] .a-programmatic__media {
    width: 50%;
  }
  .a-programmatic__details {
    display: none;
  }
  .a-programmatic__label {
    display: block;
  }
  .a-programmatic__text {
    padding: 0.25rem 0.75rem;
    display: block;
  }
}
&lt;/style&gt;

