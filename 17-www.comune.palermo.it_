<script>
document.addEventListener('DOMContentLoaded', function () {
    const loadMoreBtn = document.querySelector('#load-more-btn button');
    if (!loadMoreBtn) return;

    const label = loadMoreBtn.querySelector('.load-label');
    const spinner = loadMoreBtn.querySelector('#load-spinner');

    loadMoreBtn.addEventListener('click', function () {
        if (label && spinner) {
            label.classList.add('d-none');
            spinner.classList.remove('d-none');
        }
    });

    // ✅ MutationObserver per sapere quando i nuovi contenuti sono stati caricati
    const target = document.querySelector('#load-more');
    if (target) {
        const observer = new MutationObserver(function () {
            // Nasconde lo spinner e ri-mostra la label
            spinner.classList.add('d-none');
            label.classList.remove('d-none');
        });

        observer.observe(target, {
            childList: true,
            subtree: true
        });
    }
});
</script>

