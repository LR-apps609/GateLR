jQuery.event.special.touchstart = {
    setup: function( _, ns, handle ){
     if ( ns.includes("noPreventDefault") ) {
       this.addEventListener("touchstart", handle, { passive: false });
     } else {
       this.addEventListener("touchstart", handle, { passive: true });
     }
    }
};

jQuery.fn.clickToggle = function(a,b) {
      var ab=[b,a];
      function cb(){ ab[this._tog^=1].call(this); }
      return this.on("click", cb);
    };

function openNav() {
    
    $('body').css('overflow','hidden');
    $("#mySidenav").css('display','block');
    $("#header").css('position','inherit');
    $('#content,#opt-nav').css('margin-top','0rem');
    $('#push-screen').show(250);
    $("#mainpage").css('margin-left','0rem');
    $('a:not(#mySidenav a)').css('pointer-events','none');
   
		
}

/* Set the width of the side navigation to 0 and the left margin of the page content to 0, and the background color of body to white */
function closeNav() {
    
    $('body').css('overflow','auto');
    $("#mySidenav").css('display','none');
    $("#header").css('position','fixed');
    $('#content,#opt-nav').css('margin-top','13rem');
    $('#push-screen').hide(250);
    $("#mainpage").css('margin-left','0rem');
    $('a:not(#mySidenav a)').css('pointer-events','auto');
   
}

function openReport() {
    
    $('body').css('overflow','hidden');
    $("#header").css('position','inherit');
    $('#content,#opt-nav').css('margin-top','0rem');
    $("#mainpage").css('margin-left','0rem');
