var mobsrcopened=false;
    
$(document).on("click","#desk-src", function(event){
    
    $("#gse-send").click();
    var term =encodeURIComponent($("#q").val());

    var phrase = "search.php?q="+term+"&sa=Invia";

       window.location= phrase;
  
});

$(document).on("click","#do-mob-src", function(event){
    
    if(mobsrcopened===false){
        
        $("#m-search-box").show();
        $("#header").css("height","auto");
        
        
    }else{
        
        $("#m-search-box").hide();
        $("#header").css("height","auto");
        
    }
    
    mobsrcopened = !mobsrcopened;
  
    return false;
  

});

$('#m-gse, #q').keyup(function(e){
    
    var term =encodeURIComponent($(this).val());
    
    var phrase = "search.php?q="+term+"&sa=Invia";
    
    
    if(e.keyCode == 13)
    {   
        window.location= phrase;
        
   
    }
});
</script>
 
