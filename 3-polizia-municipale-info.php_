function validateRadios(form){
    
    let radioFields;
    let names = {};
    let count = 0;
    let name;
    
    $(".radio-btn").removeClass("error");
    
    $('#'+form+' input:radio.required').each(function() { 
        
        names[$(this).attr('name')] = true;
        name= $(this).attr('name');
        
        if($(this).prop("checked") === false){

            if ($('input[name="'+name+'"]:checked').length == 0){
                
                $(this).next('label').addClass('error');
            
            }
    
        }
 
    });
    
    $.each(names, function() {count++;});
    
    if($('#'+form+' input:radio.required:checked').length == count) {radioFields=0 ;}    

    if(radioFields==0) return true ;
    
    return false;
    
}

$( document ).on( "click",".radio-btn", function() { 

    let val = $(this).val();

    console.log('val->'+val);
   
    
    if(val==2){
        
        
        $('#motivo').prop("disabled", false); 
        
    }else{
        
        $('#motivo').prop("disabled", true);
        
    }
    


});



$( document ).on( "click","#segn-invia", function() { 
    
        $("*").removeClass("error");
        
        let url = $("#frm_segnala").serialize();       
        let radiosChecked = validateRadios('frm_segnala');
        let val = $("#motivo").val();
//        let cbval = $("#utile_2").val();
        let cbval = $("#utile_2").prop("checked");
        let privacy = $("#infoprivacy").prop("checked");
        
        console.log('privacy->'+privacy);
 
        
        if(radiosChecked==false){
        
            alert('Compilare tutti i campi obbligatori');
            return false;

        }
        
        if(cbval==true){
            
            if(val==0){
                
                alert('Selezionare il motivo');
                $("#motivo").addClass('error');
                return false;
                
            }            
        }
        
        if( privacy === false){
            
            alert('E\' necessario accettare l\'informativa privacy per procedere');
            $("label[for='infoprivacy']").addClass('error');
            return false;
            
        }

        $.ajax({

            type: "POST",
            url: 'ajax/act_ajax_send_report.php',
            data: url, 
            success: function(data) {

                if(data==1){
                    
                    alert('Segnalazione inviata con successo');
                    closeReport();
                    
                }else{

                    closeReport();
                    console.log(data);
                    alert('Problemi nell\'invio della segnalazione.');
                    return false;

                }

            }
        });

            return true;
        
});
    
$(document).on( "click", "#segnala-close", function(e) {
    
    closeReport();
    
    
});

$(document).on( "click", ".bef-ans", function(e) {
    
    e.preventDefault();
    
    if(!is_auth){
    
        if(ans_op){

            $("#answer").hide();

        }else{

             $("#answer").show();

        }

        ans_op = !ans_op;
    
    }else{
        
        openReport();
        
    }
    
    return false;
    
});


</script>    
