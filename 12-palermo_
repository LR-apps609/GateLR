          });
        });
        /* Stack smallest-scope on top. A city-wide emissions zone contains every
           ZTL inside it, so drawn last it covers them and swallows their clicks
           — on Milan the grey Area B made the centre and the Navigli
           unclickable. Mirrors Z_STACK in common.js. */
        ['lez', 'charge', 'ztl', 'apu'].forEach(function (k) {
          polys.forEach(function (p) { if (p._kind === k) p.bringToFront(); });
        });
        /* Hit areas last — the stacking above would otherwise bury them. */
        hits.forEach(function (h) { h.bringToFront(); });
        m.fitBounds(L.featureGroup(polys).getBounds().pad(0.3));
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
      else init();
    })();
  </script>
  <script src="../../nav.js"></script>
  <script src="../../consent.js"></script>
  <script src="../../adsense.js"></script>
</body>
