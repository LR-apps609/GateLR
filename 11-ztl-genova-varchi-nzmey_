    <script>
    (function(){
      var initialHash = (window.location.hash || '').slice(1);

      if(initialHash){
        try{ if('scrollRestoration' in history) history.scrollRestoration = 'manual'; }catch(e){}
        try{ history.replaceState(null, '', window.location.pathname + window.location.search); }catch(e){}
        try{ window.scrollTo(0,0); }catch(e){}
      }

      function getHeaderOffset(P){
        var hdr = document.querySelector('.' + P + '-siteHeader');
        var h = hdr ? hdr.getBoundingClientRect().height : 0;
        return Math.max(0, Math.round(h + 10));
      }

      function scrollToId(P, id, behavior){
        if(!id) return;
        var el = document.getElementById(id);
        if(!el) return;

        var offset = getHeaderOffset(P);
        var y = el.getBoundingClientRect().top + window.pageYOffset - offset;
        y = Math.max(0, y);

        try{
          window.scrollTo({ top: y, behavior: behavior || 'auto' });
        }catch(e){
          window.scrollTo(0, y);
        }
      }

      function initTOC(P){
        var tocLinks = document.querySelectorAll('.' + P + '__toc a[href^="#"]');
        if(!tocLinks.length) return;

        function onClick(e){
          var href = e.currentTarget.getAttribute('href') || '';
          if(href.charAt(0) !== '#') return;

          var id = href.slice(1);
          if(!id) return;

          e.preventDefault();
          scrollToId(P, id, 'smooth');

          try{
            history.replaceState(null, '', '#' + id);
          }catch(err){}
        }

        for(var i=0;i<tocLinks.length;i++){
          tocLinks[i].addEventListener('click', onClick);
        }

        function fixHash(){
          var hash = (window.location.hash || '').replace('#','');
          if(!hash) return;
          scrollToId(P, hash, 'auto');
          requestAnimationFrame(function(){ scrollToId(P, hash, 'auto'); });
          setTimeout(function(){ scrollToId(P, hash, 'auto'); }, 120);
          setTimeout(function(){ scrollToId(P, hash, 'auto'); }, 320);
        }

        window.addEventListener('load', fixHash, { once:true });
        window.addEventListener('pageshow', fixHash);
      }

      var P = "ztlgenovavarchi30042026";

      function initHeroAspect(P){
        var hero = document.querySelector('.' + P + '__hero:not(.' + P + '__hero--noMedia)');
        if(!hero) return;

        var img = hero.querySelector('.' + P + '__img');
        if(!img) return;

        var property = '--' + P + '-hero-aspect';

        function sync(){
          var width = img.naturalWidth || 0;
          var height = img.naturalHeight || 0;
          if(width > 0 && height > 0){
            hero.style.setProperty(property, width + ' / ' + height);
          }
        }

        img.addEventListener('load', sync);
        if(img.complete) sync();
      }

      function initBalancedMasonry(P){
        var mq = window.matchMedia('(min-width: 900px)');
        var contents = document.querySelectorAll('.' + P + '__content');
        if(!contents.length) return;

        function getBlocks(container){
          var kids = container.children;
          var out = [];
          for(var i=0;i<kids.length;i++){
            var el = kids[i];
            if(el && el.classList && el.classList.contains(P + '__block')) out.push(el);
          }
          return out;
        }

        function restore(container){
          if(!container.__masonryOriginal) return;
          while(container.firstChild) container.removeChild(container.firstChild);
          for(var i=0;i<container.__masonryOriginal.length;i++){
            container.appendChild(container.__masonryOriginal[i]);
          }
        }

        function apply(container){
          if(!container.__masonryOriginal){
            container.__masonryOriginal = getBlocks(container);
          }else{
            restore(container);
          }

          var items = container.__masonryOriginal.slice();
          if(!items.length) return;

          var wrap = document.createElement('div');
          wrap.className = P + '__masonry';

          var colA = document.createElement('div');
          colA.className = P + '__col ' + P + '__col--a';

          var colB = document.createElement('div');
          colB.className = P + '__col ' + P + '__col--b';

          wrap.appendChild(colA);
          wrap.appendChild(colB);
          container.appendChild(wrap);

          var gap = 12;
          var hA = 0, hB = 0;

          for(var i=0;i<items.length;i++){
            var it = items[i];
            var target = (hA <= hB) ? colA : colB;
            target.appendChild(it);

            var rect = it.getBoundingClientRect();
            if(target === colA) hA += rect.height + gap;
            else hB += rect.height + gap;
          }
        }

        function layout(){
          for(var i=0;i<contents.length;i++){
            var c = contents[i];
            if(mq.matches) apply(c);
            else restore(c);
          }
        }

        var scheduled = false;
        function schedule(){
          if(scheduled) return;
          scheduled = true;
          requestAnimationFrame(function(){
            scheduled = false;
            layout();
          });
        }

        var lastW = window.innerWidth;

        window.addEventListener('resize', function(){
          var w = window.innerWidth;
          if(w === lastW) return;
          lastW = w;
          schedule();
        }, { passive:true });

        window.addEventListener('orientationchange', function(){
          lastW = window.innerWidth;
          schedule();
        });

        if(mq.addEventListener) mq.addEventListener('change', schedule);
        else if(mq.addListener) mq.addListener(schedule);

        window.addEventListener('load', function(){
          schedule();
          setTimeout(schedule, 120);
        }, { once:true });

        schedule();
      }

      initTOC(P);
      initHeroAspect(P);
      initBalancedMasonry(P);
    })();
  </script>
