<script nonce="786Z9NscTnBvNGFJ0IFBSPrTBKYWPSNi">
    // Configurazione passata da PHP/Blade al JS
    var smartBannerConfig = {
        androidApp: "https:\/\/play.google.com\/store\/apps\/details?id=it.gasparilab.mysangiovannivaldarno",
        iosApp: "https:\/\/apps.apple.com\/app\/mysangiovannivaldarno\/id6743793022",
        androidMarketUrl: "market:\/\/details?id=it.gasparilab.mysangiovannivaldarno",
        iosStoreUrl: "https:\/\/apps.apple.com\/app\/mysangiovannivaldarno\/id6743793022",
        deepLink: "mysangiovannivaldarno:\/\/"    };

    document.addEventListener("DOMContentLoaded", function() {
        var ua = navigator.userAgent || navigator.vendor || window.opera;
        
        // Controlla Android
        var isAndroid = /Android/i.test(ua);
        
        // Controlla iOS (inclusi iPad con Safari Desktop mode tramite maxTouchPoints)
        var isiOS = /iPhone|iPod/i.test(ua) || 
                    (/iPad/i.test(ua)) || 
                    (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);

        // Verifica se l'utente ha già chiuso il banner
        if (localStorage.getItem("smartbanner_closed")) {
            return;
        }

        var storeWebUrl = '';
        var marketUrl = '';
        var platform = '';
        var showBanner = false;

        if (isAndroid && smartBannerConfig.androidApp) {
            showBanner = true;
            platform = 'android';
            storeWebUrl = smartBannerConfig.androidApp;
            marketUrl = smartBannerConfig.androidMarketUrl;
        } else if (isiOS && smartBannerConfig.iosApp) {
            showBanner = true;
            platform = 'ios';
            storeWebUrl = smartBannerConfig.iosStoreUrl;
            marketUrl = smartBannerConfig.iosStoreUrl;
        }

        // Se è un dispositivo mobile supportato, imposta i link e mostra il banner
        if (showBanner) {
            var banner = document.getElementById("smartbanner");
            var btn = document.getElementById("smartbanner-btn");

            if (btn) {
                btn.setAttribute('data-market-url', marketUrl);
                btn.setAttribute('data-store-url', storeWebUrl);
                btn.setAttribute('data-platform', platform);
            }

            if (banner) {
                banner.style.display = "block";
            }
        }
    });

    function closeSmartBanner() {
        var element = document.getElementById("smartbanner");
        if (element) {
            element.style.display = "none";
            localStorage.setItem("smartbanner_closed", "true");
        }
    }

    function openApp(event) {
        event.preventDefault();
        
        var btn = event.currentTarget;
        var deeplink = smartBannerConfig.deepLink;
        var marketUrl = btn.getAttribute('data-market-url');
        var webStoreUrl = btn.getAttribute('data-store-url');

        // iOS: niente deeplink (Safari mostra il popup "Aprire in «App»?" o l'errore
        // "indirizzo non valido" se l'app manca): si apre direttamente la pagina App Store,
        // che mostra "Apri" se l'app è già installata o "Ottieni" per scaricarla.
        if (btn.getAttribute('data-platform') === 'ios') {
            window.location.href = webStoreUrl;
            return;
        }

        var start = Date.now();
        var timerStore = null;
        var timerFallback = null;

        function onVisibilityChange() {
            if (document.hidden) {
                clearAppTimers();
            }
        }

        function clearAppTimers() {
            if (timerStore) clearTimeout(timerStore);
            if (timerFallback) clearTimeout(timerFallback);

            window.removeEventListener('pagehide', clearAppTimers);
            window.removeEventListener('blur', clearAppTimers);
            document.removeEventListener('visibilitychange', onVisibilityChange);
        }

        window.addEventListener('pagehide', clearAppTimers);
        window.addEventListener('blur', clearAppTimers);
        document.addEventListener('visibilitychange', onVisibilityChange);

        // 1. Tenta l'apertura dell'App tramite Deeplink
        window.location.href = deeplink;

        // 2. Se l'app NON si apre ed entro 1.2s l'utente è ancora sulla pagina web -> Apri lo Store
        timerStore = setTimeout(function() {
            if (!document.hidden && (Date.now() - start < 2000)) {
                window.location.href = marketUrl;

                // 3. Fallback web
                timerFallback = setTimeout(function() {
                    if (!document.hidden && (Date.now() - start < 3500)) {
                        window.location.href = webStoreUrl;
                    }
                }, 1000);
            }
        }, 1200);
    }
</script>

