  function open(){d.classList.add('is-open');o.classList.add('is-open');t.setAttribute('aria-expanded','true');d.setAttribute('aria-hidden','false');document.body.style.overflow='hidden';}
  function close(){d.classList.remove('is-open');o.classList.remove('is-open');t.setAttribute('aria-expanded','false');d.setAttribute('aria-hidden','true');document.body.style.overflow='';}
  t.addEventListener('click',function(){d.classList.contains('is-open')?close():open();});
  o.addEventListener('click',close);
  if(c)c.addEventListener('click',close);
  // Mobile drawer dropdown: click sull'item-with-dropdown caret toggla apertura sub-list
  d.querySelectorAll('.mobile-drawer-nav .nav-item-with-dropdown > a').forEach(function(a){
    a.addEventListener('click', function(ev){
      // Solo su mobile drawer aperto (verifica nuovo browser layout)
      if (window.matchMedia('(max-width:1023px)').matches) {
        ev.preventDefault();
        var item = a.parentElement;
        var wasOpen = item.classList.contains('is-open');
        // Chiudi tutti gli altri
        d.querySelectorAll('.mobile-drawer-nav .nav-item-with-dropdown.is-open').forEach(function(o){ if(o!==item) o.classList.remove('is-open'); });
        item.classList.toggle('is-open', !wasOpen);
      }
