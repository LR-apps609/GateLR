<!-- Tracking delle views su shop -->
			<iframe class="oncookielaw_4_accepted" data-src="/track_shop_event.php?event=pageview&url=https%3A%2F%2Fwww.quotidianodipuglia.it%2Fbari%2Fztl_bari_nuove_regole_varco_attivo-9586924.html&pay=0&device=desktop&ref=" width="1" height="1" frameborder="0"></iframe>
		
<script>
(function(l,m,a,o){
    o = new RegExp('(&|\\?)\\b'+m+'\\b');
    a = l.href;
    // CED.log("refresher: ",document.referrer,o.test(a),document.referrer.indexOf(l.host) == -1);
    // se accesso diretto o da referral esterni si va sulla url senza refresh
    if (o.test(a) && document.referrer.indexOf(l.host) == -1) {
        // rimozione e pulizia dei parametri
        l.href = a.replace(o,'').replace(/(\/[^?]*?)&/,'$1?');
    }
    // tengo un flag per capire se l'utente ha scrollato negli ultimi 30 secondi
    var scrolled = false;
    var scroll_timeout = null;
    addEventListener('scroll', function(){
        scrolled = true;
        clearTimeout(scroll_timeout);
        scroll_timeout = setTimeout(function(){
            scrolled = false;
        }, 30*1000);
    });
    setTimeout(function(){
        // disabilito sulle pagine di preview.
        if (typeof isPreview != 'undefined' && isPreview) return; // no refresh
        // disabilito se nella url c'è il parametro ?next_page
        if (new URLSearchParams(l.search).get("next_page")) return; // no refresh
        if (l.hash.includes('#next_page')) return; // no refresh
        // disabilito se nella url c'è il frammento #norefresh
        if (l.hash == '#norefresh') return; // no refresh
        if (!o.test(a)) { // devo aggiungere il parametro
            if (a.indexOf('?')>-1) a += '&'+m;
            else a += '?'+m;
        }
        if (!scrolled) l.href = a;
        else { window.history.pushState({}, '', a); l.reload() };
    }, 301000);
})(window.location,'refresh_ce');
</script>


<!-- per gli utenti loggati/abbonati setto i cookie mail hashata e abbonato -->
<script class="oncookielaw_4_accepted" type="text/plain">
    try {
        _waitOnceFor('socialbar_enabled', async function(_, user){
            
            if(user.email) {
                sha256(user.email).then((hashed_email) => setCookie('sha256_mail', hashed_email, 30));
                setCookie("md5_mail", md5(user.email), 30);
                setCookie("base64_mail", btoa(user.email), 30);
            }
            if(user.abbonato) {
                setCookie("abbonato", 1, 30);
            } else {
                setCookie("abbonato", 0, 30);
            }
            
            
            // stesse informazioni in un unico cookie json in base64
            let userInfo = {};
            if(user.email) {
                userInfo.mail = user.email;
                userInfo.sha256_mail = await sha256(user.email);
                userInfo.md5_mail = md5(user.email);
                userInfo.base64_mail = btoa(user.email);
            }
            userInfo.loggato = user.email ? 1 : 0;
            userInfo.abbonato = user.abbonato ? 1 : 0;
            let userInfoJson = JSON.stringify(userInfo);
            let userInfoBase64 = btoa(userInfoJson);
            setCookie('user_info', userInfoBase64, 90);
        });
    } catch(e) { console.log(e); }
</script>

<!-- cancello cookie per utenti che hanno accettato e poi rifiutato cookie -->
<script class="oncookielaw_4_denied" type="text/plain">
    document.cookie = "sha256_mail=; expires=Thu, 01 Jan 1970 00:00:00 UTC;";
    document.cookie = "md5_mail=; expires=Thu, 01 Jan 1970 00:00:00 UTC;";
    document.cookie = "base64_mail=; expires=Thu, 01 Jan 1970 00:00:00 UTC;";
    document.cookie = "abbonato=; expires=Thu, 01 Jan 1970 00:00:00 UTC;";
    document.cookie = "user_info=; expires=Thu, 01 Jan 1970 00:00:00 UTC;";
</script> 


<!-- liveramp -->
<script class="oncookielaw_5_accepted" type="text/plain">
    try {
        loadScript('https://ats-wrapper.privacymanager.io/ats-modules/22abe735-5e63-45c0-8471-2536925961fd/ats.js', function() {
            _waitOnceFor('socialbar_enabled', function(_, user){
                if(user.email) {
                    sha256(user.email).then((hash256) => {
                        ats.setAdditionalData({
                            'type': 'emailHashes',
                            'id': [md5(user.email), hash256]
                        });
                    });
                }
            });
        });
    } catch(e) { console.log(e); }
</script>  


