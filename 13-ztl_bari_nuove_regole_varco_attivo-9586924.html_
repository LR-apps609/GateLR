            function prebidVideoCallback(bidObj) {
                // Se la risposta è undefined, esco subito
                if (typeof bidObj === 'undefined' || bidObj === null) {
                    console.log('prebidVideoCallback - Nessuna bid pervenuta:', bidObj);
                    return false;
                }

                // Se la risposta è un array di bid (singolo o multiplo)
                if (Array.isArray(bidObj)) {
                    const validBids = bidObj.filter(b => b && b.adId && b.cpm > 0);
                    if (validBids.length === 0) {
                        console.warn('prebidVideoCallback - Nessun bid valido (array):', bidObj);
                        return false;
                    }
                    // Trova la bid con il cpm più alto
                    const bestBid = validBids.reduce((max, b) => (b.cpm > max.cpm ? b : max), validBids[0]);
                    console.log('prebidVideoCallback - bid vincente (array)', bestBid);
                    window.winningVideoBids = window.winningVideoBids || [];
                    window.winningVideoBids.push(bestBid);
                    return true;
                }

                // Se la risposta è un oggetto strutturato come { adUnitCode: { bids: [...] } }
                if (bidObj && typeof bidObj === 'object') {
                    const adUnitCodes = Object.keys(bidObj);
                    if (adUnitCodes.length === 0) {
                        console.warn('prebidVideoCallback - Bid object senza adUnitCode:', bidObj);
                        return false;
                    }
                    const adUnitCode = adUnitCodes[0];
                    let bidsArr = bidObj[adUnitCode]?.bids;

                    // Se bidsArr non è un array ma è un singolo oggetto bid
                    if (bidsArr && !Array.isArray(bidsArr)) {
                        bidsArr = [bidsArr];
                    }

                    if (!Array.isArray(bidsArr) || bidsArr.length === 0) {
                        console.warn('prebidVideoCallback - Bid object senza bids:', bidObj);
                        return false;
                    }

                    const validBids = bidsArr.filter(b => b && b.adId && b.cpm > 0);
                    if (validBids.length === 0) {
                        console.warn('prebidVideoCallback - Nessun bid valido (object):', bidsArr);
                        return false;
                    }
                    const bestBid = validBids.reduce((max, b) => (b.cpm > max.cpm ? b : max), validBids[0]);
                    console.log('prebidVideoCallback - bid vincente (object)', bestBid);
                    window.winningVideoBids = window.winningVideoBids || [];
                    window.winningVideoBids.push(bestBid);
                    return true;
                }

                // Se la risposta è un singolo oggetto bid
                if (bidObj && bidObj.adId && bidObj.cpm > 0) {
                    console.log('prebidVideoCallback - bid vincente (singolo)', bidObj);
                    window.winningVideoBids = window.winningVideoBids || [];
                    window.winningVideoBids.push(bidObj);
                    return true;
                }

                console.warn('prebidVideoCallback - Bid non valido:', bidObj);
                return false;
            }
            
            function startMagnite() {
                // load MAGNITE wrapper containing PBJS library  (PARALLEL INTEGRATION Prebib DM + Amazon TAM )
                loadScript("//micro.rubiconproject.com/prebid/dynamic/16836.js");
            }

            // example function to call whenever a parallel DM x APS
            // header bidding auction is required
            function requestHeaderBids(gptSlots) {
                /* _waitOnceFor('cookielaw_5_accepted', () => { */
                    // object to manage each request state
                    const requestManager = {
                        adserverRequestSent: false,
                        dmBidsReceived: false,
                        apsBidsReceived: false
                    };
                    
                    // create APS slot objects from GPT slots, using sizes for current viewport
                    // and skipping 'fluid' size -- any APS slots with no sizes are removed
                    /*
                    let apsSlots = gptSlots.map(function(gptSlot) {
                        return {
                            slotID: gptSlot.getSlotElementId(),
                            slotName: gptSlot.getAdUnitPath(),
                            sizes: gptSlot.getSizes(window.innerWidth, window.innerHeight).map(function(size) {
                                return size !== 'fluid' ? [ size.getWidth(), size.getHeight() ] : [];
                            }).filter(function(size) {
                                return size.length;
                            })
                        }
                        googletag.pubads().refresh(gptSlots);
                    });
                    */
                    
                    
                    // create APS slot objects from GPT slots, using sizes for current viewport
                    // and skipping 'fluid' size -- any APS slots with no sizes are removed
                    // Array delle size consentite per Amazon APS (TAM)                    
                    const apsAllowedSizes = [
                        [300,50],
                        [320,50],
                        [320,100],
                        [728,90],
                        [980,90],
                        [980,250],
                        [970,250],
                        [300,250],
                        [300,600]
                    ];                    
                    let apsSlots = gptSlots.map(function(gptSlot) {
                        // Ottieni tutte le dimensioni originali
                        let gptOriginalSizes = gptSlot.getSizes(window.innerWidth, window.innerHeight)
                            .map(size => size !== 'fluid' ? [size.getWidth(), size.getHeight()] : [])
                            .filter(size => size.length);
                    
                        // Filtra solo le dimensioni consentite
                        let apsFilteredSizes = gptOriginalSizes.filter(size =>
                            apsAllowedSizes.some(allowed => allowed[0] === size[0] && allowed[1] === size[1])
                        );
                    
                        // Log delle dimensioni originali e filtrate
                        // console.log(`TAM GPTSlot: ${gptSlot.getSlotElementId()}`);
                        // console.log("TAM GPTOriginal sizes:", gptOriginalSizes);
                        // console.log("TAM GPTFiltered sizes:", apsFilteredSizes);
                    
                        return {
                            slotID: gptSlot.getSlotElementId(),
                            slotName: gptSlot.getAdUnitPath(),
                            sizes: apsFilteredSizes
                        };
                        googletag.pubads().refresh(gptSlots);
                    });

                    // rimuovi eventuali slot senza size
                    apsSlots = apsSlots.filter(slot => slot.sizes.length > 0);

                
                    // request bids through DM
                    pbjs.que.push(function() {
                        pbjs.rp.requestBids({
                            gptSlotObjects: gptSlots,
                            callback: function() {
                                pbjs.setTargetingForGPTAsync();
                                requestManager.dmBidsReceived = true;
                                if (requestManager.apsBidsReceived) {
                                    sendAdserverRequest();
                                }
                            }
                        });
                    });
                    
                    // request VIDEO bids through DM
                    pbjs.que.push(function() {
                        pbjs.rp.requestVideoBids({
                            adServer:'custom-gam',// 'custom-gam' perché altrimenti restituisce una url VAST e non delle key-value
                            adSlotName:'/158069/videodesk',
                            playerSize: [640, 360],
                            callback: prebidVideoCallback
                        });
                    });

                    // configure APS
                    apstag.init({
                        pubID: '3695',
                        adServer: 'googletag'
                    });
                  
                    apstag.fetchBids(
                        { slots:  apsSlots }, 
                        /* { slots:  [{"slotID":"adv_LdbMastheadPush","slotName":"/38681514/QuotidianodiPuglia/Bari/LdbMastheadPush","sizes":[[728,90],[980,90],[980,250],[970,250]]},{"slotID":"adv_BoxTop","slotName":"/38681514/QuotidianodiPuglia/Bari/BoxTop","sizes":[[300,250],[300,600]]},{"slotID":"adv_BoxBottom","slotName":"/38681514/QuotidianodiPuglia/Bari/BoxBottom","sizes":[[300,250]]},{"slotID":"adv_BoxPromoAdv","slotName":"/38681514/QuotidianodiPuglia/Bari/BoxPromoAdv","sizes":[[300,250]]},{"slotID":"adv_PromoBox","slotName":"/38681514/QuotidianodiPuglia/Bari/PromoBox","sizes":[[300,250]]},{"slotID":"adv_BoxPromoAdvCeds","slotName":"/56686444/QuotidianodiPuglia/Bari/BoxPromoAdvCeds","sizes":[300,250]},{"slotID":"adv_Inread","slotName":"/38681514/QuotidianodiPuglia/Bari/Inread","sizes":[[300,250]]}] }, */
                        function () {
                            apstag.setDisplayBids();
                            requestManager.apsBidsReceived = true;
                            if (requestManager.dmBidsReceived) {
