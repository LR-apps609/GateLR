<div id="mp_strip_sticky" class="mp_placeholder"></div><script src="https://mp.cedsdigital.it/js/library.js" onload="_trigger('CEDMP.ready')"></script>
<script>
try {
    // STEP 1: Prima verifica lo stato dell'utente
    _waitOnceFor([['socialbar_enabled'], ['socialbar_disabled']], function(_, user) {

        // STEP 2: Poi verifica CEDMP e consenso cookie
        _waitOnceFor([['CEDMP.ready', 'cookielaw_1_accepted']], function() {
            function getWteid() {
                try {
                    return document.cookie.match(/wteid_927615140575951=(\d+)/)[1];
                } catch (e) {
                    try {
                        return document.cookie.match(/wt_gdpr_927615140575951=(\d+)/)[1];
                    } catch (e) {
                        return null;
                    }
                }
            }
            function callCDP() {
                return new Promise((resolve, reject) => {
                    let wteid = getWteid();
                    let uid = user?.id ?? null;
                    let request_timeout = window.setTimeout(resolve, 5 + 1000);// aspetto massimo 5 secondi, poi proseguo senza dati
                    let fetch_callback = function(response) {
                        window.clearTimeout(request_timeout);
                        try {
                            response.json().then(data => {
                                resolve(data);
                            });
                        } catch(e) {
                            console.error("CDP",e);
                            resolve(null);
                        }
                    };

                    let dati = {};
                    if (uid) {
                        dati.visitor_id = md5(''+uid);
                        dati.visitor_type = 3;
                    } else if (typeof window.cookieLawPurposes == 'object' && window.cookieLawPurposes[4]) {// ho consenso tracciamento
                        if (wteid) {
                            dati.visitor_id = md5(wteid);
                            dati.visitor_type = 2;
                        } else {
                            // chi blocca webtrekk (es iphone) potrebbe non avere wteid
                            dati.visitor_type = 0;
                        }
                    } else {
                        dati.visitor_type = 0;
                    }
                    fetch('https://api-gni.cedsdigital.it/public/cdp-user-metrics?' + new URLSearchParams(dati)).then(fetch_callback).catch(fetch_callback);
                });
            }

            let user_obj = {
                // base
                logged: !!user?.id ?? false,
                subscribed: !!user?.abbonato ?? null,
                // subscription
                subscription_status: user?.cdp?.subscription?.stato ?? null,
                subscription_recurring: user?.cdp?.subscription?.flag_ricorrente ?? null,
                subscription_payment_type: user?.cdp?.subscription?.tipo_pagamento ?? null,
                subscription_payment_category: user?.cdp?.subscription?.categoria_pagamento ?? null,
                subscription_end_date: user?.cdp?.subscription?.data_fine ?? null,
                subscription_product: user?.cdp?.subscription?.tipo_prodotto ?? null,
                subscription_duration: user?.cdp?.subscription?.tipo_durata ?? null,
                subscription_renewal_date: user?.cdp?.subscription?.data_prossimo_rinnovo_prezzo_pieno ?? null,
                subscription_omaggio: user?.cdp?.subscription?.omaggio ?? null,
                subscription_slave: user?.cdp?.subscription?.slave ?? null,
                // user
                active_devices: user?.cdp?.user?.numero_dispositivi ?? 1,
                // abbonamenti
                abbonamento_mobile: user?.abbonamenti?.mobile ?? null,
                abbonamento_digital: user?.abbonamenti?.digital ?? null,
                abbonamento_digital_plus: user?.abbonamenti?.['digital+'] ?? null,
                abbonamento_consent: user?.abbonamenti?.consent ?? null,
                abbonamento_rassegna: user?.abbonamenti?.rassegna ?? null,
                // company (azienda)
                is_azienda: user?.isCompany ?? null,
            };
            //if (!window.location.pathname.endsWith('.html')) { // non sono in pagina articolo, dove il paywall chiama già la CDP e farne due pare brutto
            // cambio, lo chiamo comunque che ci servono quei dati per mostrare banner coerenti in giro
            callCDP().then(function(CDP_data) {
                user_obj.prodotto_consigliato = CDP_data?.data?.UCDP_PRODOTTO_CONSIGLIATO ?? null;
                user_obj.azione_consigliata = CDP_data?.data?.UCDP_AZIONE_CONSIGLIATA ?? null;
                user_obj.conversion_propensity = CDP_data?.data?.UCDP_CONVERSION ?? null;
                user_obj.digital_propensity = CDP_data?.data?.UCDP_DIGITAL_PROPENSITY ?? null;
                user_obj.suggested_paywall = CDP_data?.data?.UCDP_PAYWALL ?? null;
                user_obj.promoseriale_flag = CDP_data?.data?.UCDP_PROMOSERIALE == '1';
                
                CEDMP.fetch({"strip_sticky":"#mp_strip_sticky"}, user_obj);
            });
            //} else {
            //    CEDMP.fetch({"strip_sticky":"#mp_strip_sticky"}, user_obj);
            //}
        });
    });
} catch(e) {
    console.error(e)
}
</script>
