    (function() {
        // per evitare di fare troppa roba campioniamo e tracciamo solo l'1% delle visite
                    if (Math.random() > 0.1) return;
                const script = document.createElement('script');
        script.src = 'https://unpkg.com/web-vitals@3/dist/web-vitals.iife.js';
        script.onload = function() {
            // webVitals.onINP(console.log, {
            //     reportAllChanges: true
            // });
            webVitals.onINP((evt) => {
                // console.log(evt);
                if (evt.rating == "good") return;
                // da qui in poi dobbiamo tracciare su Google Analytics
                for (let k = 0; k < evt.entries.length; k++) {
                    // Ignoriamo gli eventi senza target
                    if (!evt.entries[k].target) continue;
                    const el = evt.entries[k].target;
                    const id = el.id ? "#" + el.id : '';
                    const classes = el.className ? "." + el.className.split(' ').join(".") : '';
                    const trackingInfo = el.nodeName + " " + id + classes;

                    // console.log("TODO: traccia evento INP ", trackingInfo);

                    // Traccia Evento GA4 
                    window.dataLayer = window.dataLayer || [];
                    window.dataLayer.push({
                        'event': 'Debug',
                        'eventAction': "INP",
                        'eventCategory': "INP",
                        'eventLabel': trackingInfo,
                        'eventValue': evt.value
                    });
                }
            }, {
                reportAllChanges: true
            });
        };
        document.head.appendChild(script);
    })();
