/* Start custom CSS for column, class: .elementor-element-2de22179 *//* SEZIONE 3 - menu principale fluido */
.header-section-3 {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap; /* solo per le voci principali */
}

/* Menu visibile su desktop/tablet */
.header-section-3 .elementor-nav-menu {
    display: flex;
    justify-content: center;
    width: auto;
    max-width: 100%;
}

/* Voci principali del menu */
.header-section-3 .elementor-nav-menu > li {
    flex: 0 1 auto;        /* non forzare la larghezza, ma lascia ridurre */
    min-width: 80px;       /* evita che diventino troppo piccole */
    position: relative;    /* serve per i dropdown */
}

/* Link principali */
.header-section-3 .elementor-nav-menu > li > a {
    display: flex;          /* tutto sulla stessa riga */
    align-items: center;    /* centra simbolo verticalmente */
    padding: 5px 10px;
    white-space: nowrap;    /* evita rottura testo */
    gap: 5px;               /* spazio tra testo e simbolo */
}

/* Simbolo dropdown */
.header-section-3 .elementor-nav-menu > li.menu-item-has-children > a::after {
    display: inline-block;  /* evita che vada a capo */
    margin-left: 5px;       /* piccolo spazio tra testo e simbolo */
}

/* Dropdown menu */
.header-section-3 .elementor-nav-menu li ul {
    position: absolute;     /* dropdown sopra le altre voci */
    top: 100%;
    left: 0;
    display: none;
    white-space: nowrap;    /* evita che il testo vada a capo */
    z-index: 999;
}

/* Mostra dropdown al passaggio del mouse */
.header-section-3 .elementor-nav-menu li:hover > ul {
    display: block;
}

/* Nascondi menu completamente su mobile */
@media (max-width: 768px) {
    .header-section-3 .elementor-nav-menu {
        display: none !important;
    }
}/* End custom CSS */
