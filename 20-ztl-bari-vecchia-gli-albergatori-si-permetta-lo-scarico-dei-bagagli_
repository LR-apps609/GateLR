	function applyBackgroundFromBanner(banner) {

		if (!banner || !banner.src) {
			return;
		}

		var corsImg = new Image();

		corsImg.crossOrigin = 'anonymous';

		var url = new URL(banner.src, window.location.href);

		url.searchParams.set('_cb', Date.now());

