		<img width="768" height="576" src="https://liguria.bizjournal.it/wp-content/uploads/2018/01/Genova-Piazza_Fontane_Marose-DSCF7385.jpg" class="attachment-meloria-lbj size-meloria-lbj wp-post-image" alt="Genova piazza Fontane Marose" style="width:100%;max-width:100%;height:auto;" itemprop="image" decoding="async" loading="lazy" srcset="https://liguria.bizjournal.it/wp-content/uploads/2018/01/Genova-Piazza_Fontane_Marose-DSCF7385.jpg 1600w, https://liguria.bizjournal.it/wp-content/uploads/2018/01/Genova-Piazza_Fontane_Marose-DSCF7385-1366x1025.jpg 1366w, https://liguria.bizjournal.it/wp-content/uploads/2018/01/Genova-Piazza_Fontane_Marose-DSCF7385-256x192.jpg 256w" sizes="auto, (max-width: 768px) 100vw, 768px" />                </figure>
