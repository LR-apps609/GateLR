// Impostazioni comuni dell'app GateLR (collegate in project.yml).
// Il token pubblico di Mapbox NON sta nel repository: si legge, se c'è, da Config/Local.xcconfig (ignorato da git,
// lo crea «Installa su iPhone.command»; modello in Config/Local.xcconfig.example). Senza, Mapbox resta spento e
// l'app usa la mappa di Apple. Su GitHub il token arriva dal segreto MAPBOX_ACCESS_TOKEN del repository, se c'è.
MAPBOX_ACCESS_TOKEN =
// Il numero dell'app su App Store (per «Lascia una recensione» in Tu): vuoto finché l'app non è pubblicata
APP_STORE_ID =
// Il Team di firma (Apple ID dello sviluppatore): vuoto qui, lo scrive in Config/Local.xcconfig lo script di installazione
DEVELOPMENT_TEAM =
// 2.2: modalità prova e navigatore interno anche in Release (solo per lo sviluppo): GATELR_DEV_TOOLS = YES in Local.xcconfig
GATELR_DEV_TOOLS =
#include? "Local.xcconfig"
