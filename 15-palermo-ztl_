ore\":\"Download on the App Store\"}},\"about\":{\"title\":\"What is TollTracker?\",\"description1\":\"The app monitors in real-time the new average speed control zones on roads throughout Bulgaria.\",\"description2\":\"You'll receive an instant notification if you exceed the average speed limit for a given zone, helping you avoid fines and drive with peace of mind.\",\"benefits\":{\"anonymous\":\"Anonymous usage with no data collection\",\"gps\":\"GPS-based speed and location tracking\",\"background\":\"Works even when your phone is locked\",\"autoDetect\":\"Automatically detects entry into speed control zones\",\"battery\":\"Smart battery-saving algorithm\",\"notifications\":\"Notifications for every event\",\"compatibility\":\"Works alongside Google Maps \u0026 Apple Maps\",\"voice\":\"Smart real-time voice alerts\"},\"stats\":{\"zones\":\"Monitored Zones\",\"accuracy\":\"Accuracy\",\"monitoring\":\"Active Monitoring\",\"fines\":\"Unexpected Fines\"},\"howItWorks\":{\"title\":\"How Does Tracking Work?\",\"description\":\"We use the most up-to-date data on cameras and average speed control zones in Bulgaria, updated in real-time by our team.\"}},\"features\":{\"title\":\"How Does It Work?\",\"subtitle\":\"Four simple steps to complete road safety\",\"steps\":{\"install\":{\"title\":\"1. Install\",\"description\":\"Download the TollTracker app from Google Play or the App Store.\"},\"subscribe\":{\"title\":\"2. Subscribe\",\"description\":\"Choose the subscription plan that works best for you.\"},\"autoDetect\":{\"title\":\"3. Auto-Detection\",\"description\":\"The app automatically detects when you enter an average speed control zone.\"},\"notification\":{\"title\":\"4. Notification\",\"description\":\"Get notified if your average speed exceeds the limit.\"}},\"documentation\":{\"title\":\"Want to learn how the app works in detail?\",\"description\":\"Read our comprehensive technical documentation\",\"cta\":\"📚 Open Documentation\"},\"downloadApp\":{\"title\":\"Download the App\",\"description\":\"Start using TollTracker today on your mobile device.\\nFree 3-day trial. No charge if canceled during the trial period.\",\"apkLink\":\"📱 Download APK directly\"},\"ready\":\"Ready to get started?\",\"startNow\":\"Start Now\"},\"video\":{\"title\":\"See How It Works\",\"subtitle\":\"A quick demo of the app's main features.\",\"features\":{\"setup\":{\"title\":\"Easy Setup\",\"description\":\"Install and configure in minutes\"},\"autoTracking\":{\"title\":\"Auto Tracking\",\"description\":\"Works in the background hands-free\"},\"smartNotifications\":{\"title\":\"Smart Notifications\",\"description\":\"Get alerts at the right moment\"}},\"thumbnail\":\"TollTracker Demo Video Thumbnail\"},\"pricing\":{\"title\":\"Choose Your Plan\",\"subtitle\":\"Track every speed camera, restricted zone \u0026 average-speed zone across Europe. Pick the plan that fits your drive.\",\"freeTrialBadge\":\"3-day free trial\",\"priceNote\":\"Subscriptions are purchased and managed directly through the mobile app.\",\"weekly\":{\"title\":\"Weekly\",\"perPeriod\":\"per week\"},\"monthly\":{\"title\":\"Monthly\",\"perPeriod\":\"per month\"},\"yearly\":{\"title\":\"Yearly\",\"perPeriod\":\"per year\",\"bestValue\":\"Best Value\",\"perMonthEquivalent\":\"≈ {amount}€ / month\",\"savings\":\"Save over 75%\"},\"features\":{\"unlimited\":\"Unlimited speed-camera \u0026 zone alerts\",\"realtime\":\"Real-time hands-free notifications\",\"updated\":\"Live coverage updates across 10+ European countries\",\"autoDetect\":\"Automatic camera \u0026 zone detection\",\"waze\":\"Works alongside Google Maps \u0026 Apple Maps\",\"allData\":\"Every fine trigger covered (cameras, zones, hazards)\",\"freeTrial\":\"3-day free trial. No charge if you cancel.\",\"measureAvgSpeed\":\"Measures your average speed inside average-speed sections\"}},\"faq\":{\"title\":\"Frequently Asked Questions\",\"subtitle\":\"Find answers to the most common questions\",\"questions\":{\"whatItDoes\":{\"q\":\"What does TollTracker actually do?\",\"a\":\"TollTracker is a road-safety companion app. While you drive, it uses your location to warn you about speed cameras, red-light cameras, average-speed (section) enforcement zones, police checkpoints, and hazards like accidents, stalled vehicles, animals and road closures. It's built for drivers across Europe, in 16 languages.\"},\"freeVsPremium\":{\"q\":\"What's the difference between free and Premium?\",\"a\":\"Free Mode lets you view the live map of cameras, zones and hazards, but it does not give you smart alerts while driving. Premium adds real-time alerts, wider coverage of dangers and hazards, plus features like running minimised and extra customization.\"},\"alertTypes\":{\"q\":\"What types of alerts does TollTracker give?\",\"a\":\"Fixed speed cameras, red-light cameras, combined cameras (which can enforce speed, red lights, phone use or lane violations at once), average-speed (section control) zones, restricted zones you can be fined for entering, mobile police checkpoints, and hazards such as accidents, stopped vehicles, animals, debris and road closures.\"},\"navigation\":{\"q\":\"Can TollTracker navigate me, or do I still need a maps app?\",\"a\":\"Both work. TollTracker now has full navigation built in: search a place, address or coordinates, preview the route with arrival time, traffic and toll prices, see how many cameras, average-speed sections and restricted zones sit on it, then drive it with maneuver and lane guidance. If you would rather keep Google Maps or Apple Maps, nothing changes: TollTracker runs alongside them and warns you exactly as before.\"},\"carplay\":{\"q\":\"Does TollTracker work with Apple CarPlay and Android Auto?\",\"a\":\"Yes, on both, with the same feature set. Your car's built-in screen shows the map with cameras, average-speed sections and live reports, alert cards with the distance counting down, destination search, route preview and navigation, plus a one-tap grid for reporting police, an accident or a hazard. The car screen follows your vehicle's own day and night setting. Car screens cannot launch an app by themselves, so tap the TollTracker icon once when you get in.\"},\"offline\":{\"q\":\"Does TollTracker work without an internet connection?\",\"a\":\"The app needs a data connection to fetch nearby camera, zone and hazard information and to keep it current. If your connection drops mid-drive, alerts may pause until it's restored. Offline mode is coming soon.\"},\"freeTrial\":{\"q\":\"Is there a free trial?\",\"a\":\"Yes, a free trial is offered on eligible plans. The app clearly shows when you're in a trial period, and you won't be charged until it ends unless you cancel first.\"},\"cancel\":{\"q\":\"How do I cancel my subscription?\",\"a\":\"Subscriptions are billed through Apple or Google, so you cancel there, not in the app. On iPhone: Settings → your name → Subscriptions → TollTracker → Cancel. On Android: Play Store → Profile → Payments \u0026 subscriptions → Subscriptions → TollTracker → Cancel.\"},\"account\":{\"q\":\"Do I need to create an account to use the app?\",\"a\":\"No. TollTracker works right away with an anonymous session — no sign-up required. Creating an account is optional, and mainly useful if you want your subscription and settings to follow you across devices.\"},\"privacy\":{\"q\":\"What does TollTracker do with my location data?\",\"a\":\"Your location is used to detect nearby cameras, enforcement zones and hazards so the app can alert you in time. It is not sold, and any use for analytics or advertising is governed by the consent choices you make in the app.\"},\"background\":{\"q\":\"Will I still get alerts if I lock my phone or switch apps?\",\"a\":\"Yes, as long as notification and location permissions are granted. In Settings you can choose whether alerts fire only while TollTracker is in the foreground, or in the background too.\"},\"languages\":{\"q\":\"Which languages does TollTracker support?\",\"a\":\"Bulgarian, Czech, German, Greek, English, Spanish, French, Croatian, Hungarian, Italian, Polish, Portuguese, Romanian, Slovak, Slovenian and Turkish. The app follows your device language automatically, or you can set one manually in Settings.\"}},\"noAnswer\":\"Can't find an answer to your question?\",\"browseAll\":\"Browse all FAQs\"},\"blog\":{\"title\":\"Latest News\",\"subtitle\":\"Discover helpful tips, news and insights about the latest speed camera, average-speed section and restricted zones.\",\"viewAll\":\"View All News\",\"readMore\":\"Read More →\",\"noPostsTitle\":\"Articles Coming Soon\",\"noPostsDescription\":\"We're working on creating helpful content for you. Please check back soon.\"},\"contact\":{\"title\":\"Contact Us\",\"subtitle\":\"Have questions or suggestions? We're here to help!\",\"email\":\"Email\",\"responseTime\":\"We respond to emails within 48 hours.\"},\"footer\":{\"description\":\"TollTracker is a mobile app that warns you about speed cameras, average-speed sections and restricted zones — live, hands-free, on every drive.\",\"quickLinks\":{\"title\":\"Quick Links\",\"home\":\"Home\",\"map\":\"Map\",\"news\":\"News\",\"register\":\"Register\",\"features\":\"Features\",\"pricing\":\"Pricing\",\"about\":\"About\",\"contact\":\"Contact\"},\"support\":{\"title\":\"Support\",\"faq\":\"FAQ\",\"documentation\":\"Documentation\"},\"contactInfo\":{\"title\":\"Contact\"},\"copyright\":\"All rights reserved.\",\"legal\":{\"privacy\":\"Privacy Policy\",\"terms\":\"Terms of Service\"},\"scrollToTop\":\"Scroll to top\"},\"partners\":{\"title\":\"Partners\"},\"map\":{\"backToHome\":\"Home\",\"stats\":{\"totalSections\":\"zones\",\"totalDistance\":\"km total\",\"totalDistanceLabel\":\"Total Distance:\",\"sections\":\"zones\",\"totalSectionsLabel\":\"Total Zones:\",\"controlPoints\":\"Checkpoints:\",\"roads\":\"Roads:\"},\"table\":{\"title\":\"Average Speed Zones\",\"section\":\"Zone\",\"distance\":\"Distance\",\"duration\":\"Duration\",\"road\"