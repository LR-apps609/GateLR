v>\n                            <strong>Valido dal</strong>\n                          \n                            \n                01/08/2026                        </div>\n                \n                        <div>\n                            <strong>Valido al</strong>\n                          \n                            \n                31/08/2026                        </div>\n                \n        </div>                                                                                <div id=\"opening-hours-title-8329\" class=\"py-1\">\n        <a href=\"#opening-hours-8329-phone_availability_time-20554\"\n          class=\"text-decoration-none opening-hours-accordion\"\n          data-toggle=\"collapse\"\n          data-bs-toggle=\"collapse\"\n          data-target=\"#opening-hours-8329-phone_availability_time-20554\"\n          data-bs-target=\"#opening-hours-8329-phone_availability_time-20554\"\n          aria-controls=\"opening-hours-8329-phone_availability_time-20554\"\n          role=\"button\">\n            <i aria-hidden=\"true\" class=\"fa fa-clock-o\"></i> Ufficio URP - Orari disponibilità telefonica <i aria-hidden=\"true\" class=\"fa fa-caret-down\"></i>\n        </a>\n    </div>    <div class=\"collapse p-2 lightgrey-bg-c1 mb-1\" id=\"opening-hours-8329-phone_availability_time-20554\" aria-labelledby=\"opening-hours-title-8329\" data-parent=\"#phone_availability_time-20554\">                    \n                    \n                        <div>\n                          \n                            \n                 \t \n<dl class=\"matrix_opening_hours row my-2\">\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<dt class=\"col-2 text-nowrap\">Lun</dt>\n\t\t<dd class=\"col-10\"><span class=\"text-nowrap\">9 - 13</span></dd>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<dt class=\"col-2 text-nowrap\">Mar</dt>\n\t\t<dd class=\"col-10\"><span class=\"text-nowrap\">9 - 13</span>, <span class=\"text-nowrap\">15 - 17</span></dd>\n\t\t\t\t\t\t