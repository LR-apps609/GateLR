a-IT":"Licenza d'uso"},"dataType":"eztags","constraint":[]},{"identifier":"reading_time","name":{"eng-GB":"Read time","ger-DE":"Lesezeit","ita-IT":"Tempo di lettura"},"dataType":"ezinteger","constraint":[]},{"identifier":"related_service","name":{"eng-GB":"Reference to public service","ger-DE":"Hinweis auf den \u00f6ffentlichen Dienst","ita-IT":"Riferimento al servizio pubblico"},"dataType":"ezobjectrelationlist","constraint":["public_service"]}]}},"data":{"ita-IT":{"title":"Mobilit\u00e0: prolungata fino ad ottobre la Ztl sui Lungarni","content_type":["Comunicato stampa"],"abstract":"La Ztl sar\u00e0 attiva nei giorni di venerd\u00ec, sabato e domenica, dalle 22 alle 5","published":"2022-04-26T00:00:00+02:00","dead_line":null,"id_comunicato":null,"topics":[{"id":121,"remoteId":"topic_36","classIdentifier":"topic","class":"http:\/\/www.comune.pisa.it\/api\/opendata\/v2\/classes\/topic","languages":["ger-DE","ita-IT"],"name":{"ger-DE":"Mobilit\u00e4t","ita-IT":"Trasporto pubblico"},"link":"http:\/\/www.comune.pisa.it\/api\/opendata\/v2\/content\/read\/121","mainNodeId":"123"},{"id":195,"remoteId":"d5ffcb9ed91fa49cfdc42a7ee6fb4d81","classIdentifier":"topic","class":"http:\/\/www.comune.pisa.it\/api\/opendata\/v2\/classes\/topic","languages":["ita-IT"],"name":{"ita-IT":"Mobilit\u00e0 sostenibile"},"link":"http:\/\/www.comune.pisa.it\/api\/opendata\/v2\/content\/read\/195","mainNodeId":"197"}],"body":"<p>Il Comune di Pisa, con un\u2019ordinanza firmata dal dirigente della Polizia Municipale Alberto Messerini, ha prorogato fino al prossimo 2 ottobre la Zona a Traffico Limitato sui Lungarni del centro cittadino. La nuovo ordinanza proroga, a partire da venerd\u00ec 22 aprile, l\u2019applicazione della ZTL ai soli giorni del fine settimana, venerd\u00ec, sabato e domenica, dalle ore 22 alle ore 5 del giorno successivo.<\/p><p>Nel dettaglio, queste le strade interessate: Lungarno Pacinotti, Piazza Carrara, via San Nicola, via Santa Maria (tratto compreso tra Via San Nicola e Lungarno Pacinotti), Lungarno Mediceo, piazza Mazzini, Lungarno Galileo Galilei, Lungarno Gambacorti, Ponte di Mezzo.<\/p><p>\nIl provvedimento \u00e8 stato prorogato vista la necessit\u00e0, anche per i mesi estivi, di limitare gli accessi veicolari sui Lungarni al fine di evitare situazioni di potenziali pericoli per i pedoni, nel fine settimana e negli orari in cui \u00e8 maggiore l\u2019affluenza di persone nella zona interessata.<br \/>\u00abInizia oggi una piccola rivoluzione nel rapporto delle associazioni culturali con l\u2019Amministrazione comunale. Questo portale sar\u00e0 un luogo virtuale nel quale tutte le associazioni dovranno registrarsi per poter accedere a contributi, patrocini e concessioni di spazi comunali e gli consentir\u00e0 di auto promuovere tutti gli eventi che andranno a fare nel corso dell\u2019anno - spiega l\u2019assessore alla cultura Pierpaolo Magnani -. In questo modo andr\u00e0 a formarsi un calendario complessivo degli eventi che si tengono a Pisa nell\u2019arco dell\u2019anno, ottenendo cos\u00ec un doppio risultato di evitare inutili sovrapposizioni di date e di mettere a disposizione di cittadini e turisti un unico calendario dove sapere giorno per giorno tutto quello che c\u2019\u00e8 da fare in citt\u00e0\u00bb.<\/p><p>Ogni associazione iscritta al portale della cultura sar\u00e0 quindi abilitata a inserire il proprio calendario di eventi in programma nell\u2019anno in corso, completo di immagini e video attraverso link esterni. I contenuti confluiranno in ordine cronologico in un calendario comprensivo anche di altri eventi organizzati e promossi dal Comune di Pisa e di ogni iniziativa culturale che si svolga in citt\u00e0.<\/p>","image":[{"id":3915,"remoteId":"ocm_autoimage_f27e763f2f41f02c8ba504a6e5b7883d","classIdentifier":"image","class":"http:\/\/www.comune.pisa.it\/api\/opendata\/v2\/classes\/image","languages":["ger-DE","ita-IT"],"name":{"ger-DE":"Lungarni.jpg?itok=O1NceUrr","ita-IT":"Lungarni.jpg?itok=O1NceUrr"},"link":"http:\/\/www.comune.pisa.it\/api\/opendata\/v2\/content\/read\/3915","mainNodeId":"4439"}],"people":[],"location":[],"video":null,"author":[{"id":1327,"remoteId":"unit\u00e0_8","classIdentifier":"organization","class":"http:\/\/www.comune.pisa.it\/api\/opendata\/v2\/classes\/organization","languages":["ita-IT"],"name":{"ita-IT":"Ufficio Stampa e Comunicazione"},"link":"http:\/\/www.comune.pisa.it\/api\/opendata\/v2\/content\/read\/1327","mainNodeId":"1392"}],"audio":[],"attachment":[],"files":null,"dataset":[],"help":[],"license":[],"reading_time":"0","related_service":[]}},"extradata":{"ita-IT":{"urlAlias":"\/Novita\/Comunicati\/Mobilita-prolungata-fino-ad-ottobre-la-Ztl-sui-Lungarni"}}}