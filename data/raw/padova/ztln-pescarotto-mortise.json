-4abd-96e1-eed04523b3ed\/field_tags?resourceVersion=id%3A289783"},"self":{"href":"http:\/\/www.comune.padova.it\/api\/informations\/6c989321-9be2-4abd-96e1-eed04523b3ed\/relationships\/field_tags?resourceVersion=id%3A289783"}}},"information_partials":[{"type":"text","id":"d6e1085c-2402-4175-9599-a4e62f52a3f5","links":{"self":{"href":"http:\/\/www.comune.padova.it\/api\/partials\/text\/d6e1085c-2402-4175-9599-a4e62f52a3f5?resourceVersion=id%3A333634"}},"drupal_internal__id":35576,"status":true,"created":"2024-11-28T18:58:24+00:00","text_body":{"value":"\u003C?xml encoding=\u0022utf-8\u0022 ?\u003E\u003Cbr\u003E\u003Ch3\u003EDescrizione\u003C\/h3\u003E\u003Cp\u003EPer contrastare i fenomeni legati alla prostituzione \u0026egrave; stata istituita\u0026nbsp;una zona\u0026nbsp;a traffico limitato notturno (ztl) e sono stati introdotti\u0026nbsp;dei cambiamenti alla viabilit\u0026agrave; per ridurre i punti di accesso e garantire un maggior controllo dell\u0027area.\u003Cbr\u003E\r\n\u003Cbr\u003E\r\nLe zone interessate sono:\u003Cbr\u003E\r\n- il Pescarotto,\u003Cbr\u003E\r\n- via Mortise.\u003C\/p\u003E\n","format":null,"processed":"\u003Cp\u003E\u0026lt;?xml encoding=\u0026quot;utf-8\u0026quot; ?\u0026gt;\u0026lt;br\u0026gt;\u0026lt;h3\u0026gt;Descrizione\u0026lt;\/h3\u0026gt;\u0026lt;p\u0026gt;Per contrastare i fenomeni legati alla prostituzione \u0026amp;egrave; stata istituita\u0026amp;nbsp;una zona\u0026amp;nbsp;a traffico limitato notturno (ztl) e sono stati introdotti\u0026amp;nbsp;dei cambiamenti alla viabilit\u0026amp;agrave; per ridurre i punti di accesso e garantire un maggior controllo dell\u0026#039;area.\u0026lt;br\u0026gt;\u003Cbr \/\u003E\n\u0026lt;br\u0026gt;\u003Cbr \/\u003E\nLe zone interessate sono:\u0026lt;br\u0026gt;\u003Cbr \/\u003E\n- il Pescarotto,\u0026lt;br\u0026gt;\u003Cbr \/\u003E\n- via Mortise.\u0026lt;\/p\u0026gt;\u003C\/p\u003E\n"},"text_title":null,"meta":{"target_revision_id":333634,"drupal_internal__target_id":35576},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"ccf84c64-f997-47ef-a79e-ed7e27dac27f","meta":{"drupal_internal__target_id":"text"}}},{"type":"text","id":"7d983270-b043-4d6d-8732-b3f03461c9cb","links":{"self":{"href":"http:\/\/www.comune.padova.it\/api\/partials\/text\/7d983270-b043-4d6d-8732-b3f03461c9cb?resourceVersion=id%3A333637"}},"drupal_internal__id":35579,"status":true,"created":"2024-11-28T18:58:24+00:00","text_body":{"value":"\u003C?xml encoding=\u0022utf-8\u0022 ?\u003E\u003Cbr\u003E\u003Ch3\u003EQuando\u003C\/h3\u003E\u003Cp\u003EDalle 22:00 alle 5:00, tutti i giorni della settimana (feriali e festivi).\u003C\/p\u003E\n","format":null,"processed":"\u003Cp\u003E\u0026lt;?xml encoding=\u0026quot;utf-8\u0026quot; ?\u0026gt;\u0026lt;br\u0026gt;\u0026lt;h3\u0026gt;Quando\u0026lt;\/h3\u0026gt;\u0026lt;p\u0026gt;Dalle 22:00 alle 5:00, tutti i giorni della settimana (feriali e festivi).\u0026lt;\/p\u0026gt;\u003C\/p\u003E\n"},"text_title":null,"meta":{"target_revision_id":333637,"drupal_internal__target_id":35579},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"ccf84c64-f997-47ef-a79e-ed7e27dac27f","meta":{"drupal_internal__target_id":"text"}}},{"type":"text","id":"583b1fc2-60e6-4dce-bdd2-fe880d43474e","links":{"self":{"href":"http:\/\/www.comune.padova.it\/api\/partials\/text\/583b1fc2-60e6-4dce-bdd2-fe880d43474e?resourceVersion=id%3A333640"}},"drupal_internal__id":35582,"status":true,"created":"2024-11-28T18:58:24+00:00","text_body":{"value":"\u003C?xml encoding=\u0022utf-8\u0022 ?\u003E\u003Cbr\u003E\u003Ch3\u003EDove\u003C\/h3\u003E\u003Cp\u003E\u003Cstrong\u003EPESCAROTTO\u003C\/strong\u003E\u003Cbr\u003E\r\nLa ztl\u0026nbsp;notturna comprende le vie del rione Pescarotto:\u003Cbr\u003E\r\n- via del Pescarotto -\u0026nbsp;tratto compreso tra via Maroncelli e via Friburgo,\u003Cbr\u003E\r\n- via Curiel,\u003Cbr\u003E\r\n-\u0026nbsp;via Pastro,\u003Cbr\u003E\r\n-\u0026nbsp;via Fambri,\u003Cbr\u003E\r\n-\u0026nbsp;via Salvo d\u0027Acquisto,\u003Cbr\u003E\r\n- via Campioni,\u003Cbr\u003E\r\n- via Mascherpa,\u003Cbr\u003E\r\n-\u0026nbsp;via Cortese,\u003Cbr\u003E\r\n- via Godina,\u003Cbr\u003E\r\n- via Sciesa,\u003Cbr\u003E\r\n-\u0026nbsp;via Verit\u0026agrave;,\u003Cbr\u003E\r\n- via Confalonieri,\u003Cbr\u003E\r\n-\u0026nbsp;via Anfossi,\u003Cbr\u003E\r\n- via Tonzig,\u003Cbr\u003E\r\n-\u0026nbsp;via Maroncelli - tratto compreso tra via del Pescarotto e\u0026nbsp;via Grassi.\u003Cbr\u003E\r\n\u003Cbr\u003E\r\n\u003Ca href=\u0022http:\/\/www.padovanet.it\/allegati\/C_1_Allegati_4228_Allegato.pdf\u0022\u003EOrdinanza e mappa\u003C\/a\u003E\u003C\/p\u003E\u003Cp\u003E\u003Cstrong\u003EVIA MORTISE\u003C\/strong\u003E\u003Cbr\u003E\r\nLa ztl notturna comprende il tratto tra via del Plebiscito e il numero civico 57.\u003Cbr\u003E\r\n\u003Cbr\u003E\r\n\u003Ca href=\u0022http:\/\/www.padovanet.it\/allegati\/C_1_Allegati_10286_Allegato.pdf\u0022\u003EOrdinanza\u003C\/a\u003E\u003C\/p\u003E\n","format":null,"processed":"\u003Cp\u003E\u0026lt;?xml encoding=\u0026quot;utf-8\u0026quot; ?\u0026gt;\u0026lt;br\u0026gt;\u0026lt;h3\u0026gt;Dove\u0026lt;\/h3\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;PESCAROTTO\u0026lt;\/strong\u0026gt;\u0026lt;br\u0026gt;\u003Cbr \/\u003E\nLa ztl\u0026amp;nbsp;notturna comprende le vie del rione Pescarotto:\u0026lt;br\u0026gt;\u003Cbr \/\u003E\n- via del Pescarotto -\u0026amp;nbsp;tratto compreso tra via Maroncelli e via Friburgo,\u0026lt;br\u0026gt;\u003Cbr \/\u003E\n- via Curiel,\u0026lt;br\u0026gt;\u003Cbr \/\u003E\n-\u0026amp;nbsp;via Pastro,\u0026lt;br\u0026gt;\u003Cbr \/\u003E\n-\u0026amp;nbsp;via Fambri,\u0026lt;br\u0026gt;\u003Cbr \/\u003E\n-\u0026amp;nbsp;via Salvo d\u0026#039;Acquisto,\u0026lt;br\u0026gt;\u003Cbr \/\u003E\n- via Campioni,\u0026lt;br\u0026gt;\u003Cbr \/\u003E\n- via Mascherpa,\u0026lt;br\u0026gt;\u003Cbr \/\u003E\n-\u0026amp;nbsp;via Cortese,\u0026lt;br\u0026gt;\u003Cbr \/\u003E\n- via Godina,\u0026lt;br\u0026gt;\u003Cbr \/\u003E\n- via Sciesa,\u0026lt;br\u0026gt;\u003Cbr \/\u003E\n-\u0026amp;nbsp;via Verit\u0026amp;agrave;,\u0026lt;br\u0026gt;\u003Cbr \/\u003E\n- via Confalonieri,\u0026lt;br\u0026gt;\u003Cbr \/\u003E\n-\u0026amp;nbsp;via Anfossi,\u0026lt;br\u0026gt;\u003Cbr \/\u003E\n- via Tonzig,\u0026lt;br\u0026gt;\u003Cbr \/\u003E\n-\u0026amp;nbsp;via Maroncelli - tratto compreso tra via del Pescarotto e\u0026amp;nbsp;via Grassi.\u0026lt;br\u0026gt;\u003Cbr \/\u003E\n\u0026lt;br\u0026gt;\u003Cbr \/\u003E\n\u0026lt;a href=\u0026quot;\u003Ca href=\u0022http:\/\/www.padovanet.it\/allegati\/C_1_Allegati_4228_Allegato.pdf\u0026quot;\u0026gt;Ordinanza\u0022\u003Ehttp:\/\/www.padovanet.it\/allegati\/C_1_Allegati_4228_Allegato.pdf\u0026quot;\u0026gt;Ordina\u2026\u003C\/a\u003E e mappa\u0026lt;\/a\u0026gt;\u0026lt;\/p\u0026gt;\u0026lt;p\u0026gt;\u0026lt;strong\u0026gt;VIA MORTISE\u0026lt;\/strong\u0026gt;\u0026lt;br\u0026gt;\u003Cbr \/\u003E\nLa ztl notturna comprende il tratto tra via del Plebiscito e il numero civico 57.\u0026lt;br\u0026gt;\u003Cbr \/\u003E\n\u0026lt;br\u0026gt;\u003Cbr \/\u003E\n\u0026lt;a href=\u0026quot;\u003Ca href=\u0022http:\/\/www.padovanet.it\/allegati\/C_1_Allegati_10286_Allegato.pdf\u0026quot;\u0026gt;Ordinanza\u0026lt;\/a\u0026gt;\u0026lt;\/p\u0026amp;gt\u0022\u003Ehttp:\/\/www.padovanet.it\/allegati\/C_1_Allegati_10286_Allegato.pdf\u0026quot;\u0026gt;Ordin\u2026\u003C\/a\u003E;\u003C\/p\u003E\n"},"text_title":null,"meta":{"target_revision_id":333640,"drupal_internal__target_id":35582},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"ccf84c64-f997-47ef-a79e-ed7e27dac27f","meta":{"drupal_internal__target_id":"text"}}},{"type":"text","id":"fb003012-5ec6-482c-a8fc-b9e64502532c","links":{"self":{"href":"http:\/\/www.comune.padova.it\/api\/partials\/text\/fb003012-5ec6-482c-a8fc-b9e64502532c?resourceVersion=id%3A333643"}},"drupal_internal__id":35585,"status":true,"created":"2024-11-28T18:58:24+00:00","text_body":{"value":"\u003C?xml encoding=\u0022utf-8\u0022 ?\u003E\u003Cbr\u003