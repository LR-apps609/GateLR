quotidiano.net/video/in-vista","target":"_self","nofollow":false,"content":null,"__typename":"Link"},"layout":"Layout-widget-sidebar-1","style":"DEFAULT","adPosition":"NO_ADS","customHtmlFragmentDesktop":"","customHtmlFragmentMobile":"","teasers":{"totalCount":1,"teasers":[{"id":"contentid/YmI3N2UzYTUtMzFhZC00","title":"Congresso Lega, Zaia: Nel nuovo simbolo vedo l'auspicio al federalismo","disableFallback":false,"layout":null,"text":"(Agenzia Vista) Milano, 25 ottobre 2026\n\"A me piace il nuovo simbolo proposto da Salvini, la leggo come un'Italia che diventerà federale e quindi una federazione di più realtà\". Lo ha detto Luca Zaia parlando a margine del congresso straordinario della Lega. E ha aggiunto: \"Einaudi nel '48, presentando la Costituzione repubblicana, diceva: 'A ognuno dovremmo dare l'autonomia che gli spetta', esattamente il compimento di quello che prevedevano i padri costituenti che in un paese in cui si è investito nel centralismo non si è mai attuato\".\nFonte: Agenzia Vista / Alexander Jakhnagiev","longText":"","teaserOvertitle":"","byline":"","authors":[],"media":{"mediaId":"xbr69cq","subType":"standard","image":null,"embedCode":null,"format":"16:9","publishedDate":"2026-10-25T19:03:44.004Z","playlist":[],"__typename":"Video"},"content":{"__typename":"Video","mediaUrl":null,"mediaId":"xbr69cq","path":"https://www.quotidiano.net/video/in-vista/congresso-lega-zaia-nel-nuovo-simbolo-vedo-lauspicio-al-federalismo-ike5iesw","format":"16:9","caption":"(Agenzia Vista) Milano, 25 ottobre 2026\n\"A me piace il nuovo simbolo proposto da Salvini, la leggo come un'Italia che diventerà federale e quindi una federazione di più realtà\". Lo ha detto Luca Zaia parlando a margine del congresso straordinario della Lega. E ha aggiunto: \"Einaudi nel '48, presentando la Costituzione repubblicana, diceva: 'A ognuno dovremmo dare l'autonomia che gli spetta', esattamente il compimento di quello che prevedevano i padri costituenti che in un paese in cui si è investito nel centralismo non si è mai attuato\".\nFonte: Agenzia Vista / Alexander Jakhnagiev","publishedDate":"2026-10-25T19:03:44.004Z","image":null,"parent":{"title":"In vista","path":"/video/in-vista","hideSectionTitle":false,"__typename":"Section"},"hideAuthor":true,"byline":null},"__typename":"Teaser"}],"__typename":"Teasers"},"__typename":"Slot"},{"id":"contentid/OGJlNTE4M2ItYmMwYy00","name":"lanazione-slot-trending-topics","headline":"","headlineStyle":"","colorScheme":"monochrome","hidden":false,"externalName":"slot-trending-topics-firenze","widgetId":null,"image":null,"link":null,"layout":"Layout-Trending","style":"DEFAULT","adPosition":"NO_ADS","customHtmlFragmentDesktop":"","customHtmlFragmentMobile":"","teasers":{"totalCount":10,"teasers":[{"id":"contentid/NTFhMTU0NGMtZmVkZi00","title":"\u003cp\u003eIncidente FiPiLi\u003c/p\u003e","disableFallback":false,"layout":"trending","text":"","longText":"","teaserOvertitle":"","byline":"","authors":[],"media":null,"content":{"__typename":"Link","url":"https://www.lanazione.it/cronaca/incidente-fipili-interporto-ujtqosbv","target":"_self","nofollow":false,"label":"\u003cp\u003eIncidente FiPiLi\u003c/p\u003e","content":null},"__typename":"Teaser"},{"id":"contentid/OWViNzEzNDQtZDcyOS00","title":"\u003cp\u003eManifestazione Firenze\u003c/p\u003e","disableFallback":false,"layout":"trending","text":"","longText":"","teaserOvertitle":"","byline":"","authors":[],"media":null,"content":{"__typename":"Link","url":"https://www.lanazione.it/firenze/cronaca/manganelli-e-bottigliate-a-firenze-la-guerriglia-va-in-scena-a-santa-trinita-incappucciati-come-furie-scontri-fino-a-sera-yhwiycx9","target":"_self","nofollow":false,"label":"\u003cp\u003eManifestazione Firenze\u003c/p\u003e","content":null},"__typename":"Teaser"},{"id":"contentid/M2FmOTAyNDAtYTRhNC00","title":"\u003cp\u003eTruffa commercialista\u003c/p\u003e","disableFallback":false,"layout":"trending","text":"","longText":"","teaserOvertitle":"","byline":"","authors":[],"media