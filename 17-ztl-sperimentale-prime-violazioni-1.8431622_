//fonts.gstatic.com/s/robotocondensed/v31/ieVl2ZhZI2eCN5jzbjEETS9weq8-19K7DQk6YvM.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}</style></head><body id="" class="articlepage"><div id="banner__notifications"></div><div id="__next"><main class="__variable_8e089d __variable_71bfa3 __variable_7b2ea5 __variable_848d1d __variable_b33009 __variable_059c72"><script type="application/ld+json" id="https://www.lanazione.it/arezzo/cronaca/ztl-sperimentale-prime-violazioni-9edd58a4">{"@context":"https://schema.org","@type":"NewsArticle","mainEntityOfPage":{"@type":"WebPage","@id":"https://www.lanazione.it/arezzo/cronaca/ztl-sperimentale-prime-violazioni-9edd58a4","name":"Ztl sperimentale, prime violazioni"},"articleSection":"Cronaca Arezzo","headline":"Ztl sperimentale, prime violazioni","description":"Le multe non si pagano ancora, ma molti cittadini già in confusione a gestire gli otto varchi previsti","keywords":"ztl,sperimentale,prime,violazioni","url":"https://www.lanazione.it/arezzo/cronaca/ztl-sperimentale-prime-violazioni-9edd58a4","isAccessibleForFree":true,"articleBody":"Prime difficoltà a Sansepolcro con l’entrata in vigore della Ztl sperimentale partita proprio i primi giorni del mese. Non è stata ancora assimilata dai cittadini di Sansepolcro la disciplina relativa alla nuova zona a traffico limitato nel centro storico e anche se le multe in questa prima fase non vengano fatte si sarebbero già registrate le prime violazioni. Ci sono stati problemi anche sul rinnovo dei permessi e per questo la Polizia Municipale ed il Comune stanno cercando di fare chiarezza su tutte le procedure per il rilascio dei pass. La nuova Ztl ha otto diversi accessi ed ogni cittadino può avere il permesso per il solo varco vicino alla sua abitazione. E questo ha creato un po’ di confusione in alcuni, che magari pensavano di poter accedere al centro storico da tutti i varchi della Ztl. Questa fase sperimentale per il videocontrollo, nella quale non è prevista l’elevazione di sanzioni avrà la durata di circa un mese (salvo diverse decisioni) e terminerà presumibilmente in febbraio. In questo periodo di transizione, l’amministrazione comunale biturgense ricorda che le autorizzazioni della zona a traffico limitato, in scadenza nel mese di gennaio, dovranno essere rinnovate utilizzando l’apposita modulistica disponibile sul sito istituzionale del Comune, all’ufficio relazioni con il pubblico e negli uffici della polizia municipale. Rispetto agli scorsi anni, le variazioni consistono nella suddivisione della Ztl di Sansepolcro in otto aree, dalle quali si accede da altrettanti varchi posti in via XX Settembre alle intersezioni con via della Fortezza, con via Giovanni Buitoni, con via Piero della Francesca, con via Luca Pacioli, con via Giuseppe Mazzini e con via Giordano Bruno; le altre sono invece situate in via Giacomo Matteotti (intersezione con via della Firenzuola e via Giulia Boninsegni Buitoni) e via dei Servi, accesso da Piazza Dotti. Un’altra modifica riguarda il senso di marcia delle strade escluse dagli otto varchi sopra elencati che conducono al corso principale, via XX Settembre, le quali saranno disciplinate a senso unico con direzione uscita dal centro storico. Infine la novità della sostituzione dei vecchi permessi annuali rilasciati ai residenti con delle autorizzazioni pluriennali (si tratta di una fase successiva). Le modalità di rinnovo dovranno rispettare il regolamento della Ztl e le ordinanze del Comune in materia, pertanto le categorie ammesse al transito e alla sosta nella zona a traffico limitato dovranno accedere esclusivamente solo da uno degli otto varchi indicati. I rinnovi dei permessi già rilasciati ai residenti negli scorsi anni saranno gratuiti, mentre per la richiesta delle altre autorizzazioni saranno necessarie due marche da bollo e il versamento dei diritti; infine, i veicoli autorizzabili alla circolazione non dovranno avere un peso a pieno carico superiore alle tre tonnellate e mezza. C.R.","about":[{"@type":"Thing","name":"Cronaca"}],"mentions":[{"@type":"DefinedTerm","name":"Cronaca"}],"contentLocation":{"@type":"Place","name":"Arezzo","address":{"@type":"PostalAddress","addressCountry":"IT","addressLocality":"Arezzo"}},"dateline":"AREZZO, IT","dateCreated":"2023-01-04T07:21:51+00:00","datePublished":"2023-01-04T07:21:51+00:00","dateModified":"2023-01-04T07:21:51+00:00","image":{"@type":"ImageObject","url":"https://www.lanazione.it/image-service/version/c:Zjc2OTAwNTYtNDg5Mi00:NTYtNDg5Mi00ZWNlODcy/migration.jpg","width":1200,"height":675},"author":{"@type":"Person","name":"Redazione Arezzo","worksFor":{"@type":"Organization","name":"La Nazione","logo":{"@type":"ImageObject","url":"https://www.lanazione.it/logo/lanazione.svg","width":2338,"height":1307}}},"publisher":{"@type":"NewsMediaOrganization","@id":"https://www.lanazione.it#publisher","name":"La Nazione","sameAs":"https://www.lanazione.it","logo":{"@type":"ImageObject","url":"https://www.lanazione.it/logo/lanazione.svg","width":2338,"height":1307}},"creator":{"@type":"Organization","name":"La Nazione"},"isPartOf":{"@type":["CreativeWork","Product"],"name":"La Nazione","productID":"lanazione:online"}}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"item":{"@id":"https://www.lanazione.it","name":"Home"}},{"@type":"ListItem","position":2,"item":{"@id":"https://www.lanazione.it/arezzo","name":"Arezzo"}},{"@type":"ListItem","position":3,"item":{"@id":"https://www.lanazione.it/arezzo/cronaca","name":"Cronaca"}},{"@type":"ListItem","position":4,"item":{"@id":"https://www.lanazione.it/arezzo/cronaca/ztl-sperimentale-prime-violazioni-9edd58a4","name":"Ztl sperimentale, prime violazioni"}}]}</script><div></div><header class="Header_header__g2756"><div class="TopRow_topRow___Bie1"><div c