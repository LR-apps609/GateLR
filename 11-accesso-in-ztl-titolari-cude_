  box-shadow: none;
	color:#000;
}
.accordion2-button::after {
  content: "▶"!important; 
  font-size: 14px;
  margin-left: auto;
  transition: transform 0.3s ease;
}
.accordion2-button:not(.collapsed)::after {
  content: "▼"!important; 
  transform: rotate(0deg);
	color:#000;
}
