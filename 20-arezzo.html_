            <form id="searchdesc" method="post" action="" onsubmit="return false;">
                <div class="boxleft">
                    <input type="hidden" value="ztl" name="url_rew">
                    <input type="hidden" value="ok" name="ric">
                    <input type="text" value="Cerca citt&agrave;" name="ztl" onclick="javascript:pulisciboxric(ztl);" id="tags" class="ui-autocomplete-input" autocomplete="off"><span role="status" aria-live="polite" class="ui-helper-hidden-accessible"></span> 
                </div>
                <div class="boxright" style="">
                     <button type="submit" name="cerca" value="Search" title="Cerca" onclick="searchSubmit()">Cerca</button>
                </div>
            </form>     
        </div><script type="text/javascript">
            function searchSubmit()
            {
                var tag = document.getElementById('tags').value;
                
                if (tag != "" && tag != "Cerca citt?" && tag != "Search city"  )
                {
                    tag = tag.charAt(0).toUpperCase() + tag.slice(1);
                    
                    tagIndex = availableTags.indexOf(tag);
                    
                    var ztl = availableTags_url_rew_ztl[tagIndex];
                    var citta = availableTags_url_rew_citta[tagIndex];
                    var regione = availableTags_url_rew_regioni[tagIndex];

                    if (typeof ztl !== 'undefined')
                    {
                        if (ztl == citta)
                        {
                           
                            document.location.href='/ztl/' + regione + '/' + citta + '.html';
                        }
                        else
                        {
                            document.location.href='/ztl/' + regione + '/' + citta + '/' + ztl + '.html';
                        }
                    }
                    else
                    {
                        return false;
                    }
                }
                else return false;
            }
            
            
            function formSubmit()
            {
                var numero_voci_mancanti=0;
                var messaggio="";
                var errore=0;

                if (document.getElementById("MyOtherForm").regione.value=='')
                {
                    messaggio+="- Regione\n";
                    numero_voci_mancanti++;
                }
                   
                if (document.getElementById("MyOtherForm").comune.value=='')
                {
                    messaggio+="- Citta'";
                    numero_voci_mancanti++;
                }
                  
                if (document.getElementById("MyOtherForm").ztl.value=='')
                {
                    messaggio+="- Ztl\n";
                    numero_voci_mancanti++;
                }
                  
                if(numero_voci_mancanti != 0)
                {
                    if (errore!=1)
                    {
                        if(numero_voci_mancanti==1)
                        {
                            messaggio="ERRORE: Campo non inserito: "+messaggio;    
                        }
                            
                        else
                        {
                            messaggio="ERRORE: Campi non inseriti: "+messaggio;     
                        }
                            
                        alert(messaggio);
                    }    
                }
                          
                if(numero_voci_mancanti == 0)
                {
                    if(errore!=1)
                    {
                        if (document.getElementById("MyOtherForm").ztl.value==document.getElementById("MyOtherForm").comune.value)
                        {
                            document.location.href='/ztl/'+document.getElementById("MyOtherForm").regione.value+'/'+document.getElementById("MyOtherForm").comune.value+'.html';
                        }
                        else
                        {
                            document.location.href='/ztl/'+document.getElementById("MyOtherForm").regione.value+'/'+document.getElementById("MyOtherForm").comune.value+'/'+document.getElementById("MyOtherForm").ztl.value+'.html';
                        }
                    }    
                } 
            }
        </script><form id="MyOtherForm" name="MyOtherForm" action="" method="post"> 
