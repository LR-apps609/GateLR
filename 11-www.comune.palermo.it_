}
ul.sitemap > li {
    border-bottom: 1px solid #ccc;
    padding-bottom: 5px;
    margin-bottom: 5px;
}
ul.sitemap ul.sub-menu {
    display:  block;
}
ul.sitemap li:hover > ul.sub-menu {
    display: block;
}
